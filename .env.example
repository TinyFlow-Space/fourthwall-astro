# Create a project at https://sanity.io/manage, then copy this file to .env.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SITE_URL=http://localhost:4321
BLOG_POSTS_PER_PAGE=6
# Optional, only for a private dataset. Never use a PUBLIC_ prefix for a token.
# Set this as a Cloudflare runtime secret in production.
SANITY_API_READ_TOKEN=
