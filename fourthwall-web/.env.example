# Create a project at https://sanity.io/manage, then copy this file to .env.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SITE_URL=http://localhost:4321
BLOG_POSTS_PER_PAGE=6
# Optional for private datasets. Public published content needs no token.
# Set this as a Cloudflare runtime secret in production.
SANITY_API_READ_TOKEN=

# Studio origin used by click-to-edit links.
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Enabled automatically in development; opt in on deployed editing environments.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false
