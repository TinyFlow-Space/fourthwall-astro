---
import { focalPoint, num, ratio, str, type Block, type BuilderImage } from "@/lib/builder";
import { imageUrl } from "@/lib/sanity/presentation";
interface Props { block: Block; attrs?: Record<string, string | undefined> }
const { block, attrs } = Astro.props;
const image = block.image as BuilderImage | undefined;
const aspect = ratio(block.aspectRatio);
const height = (width: number) => (aspect ? Math.round(width / aspect) : undefined);
const src = imageUrl(image, 1600, height(1600));
const maxWidth = typeof block.maxWidth === "number" ? `${num(block.maxWidth, 1200)}px` : undefined;
---

{src && (
  <figure
    class="pb-media"
    style={{ maxWidth, aspectRatio: aspect ? String(aspect) : undefined, borderRadius: `${num(block.radius, 12)}px` }}
    {...attrs}
  >
    <img
      src={src}
      srcset={`${imageUrl(image, 800, height(800))} 800w, ${src} 1600w`}
      sizes="(max-width: 991px) 100vw, 1200px"
      loading="lazy"
      alt={str(image?.alt)}
      style={{ objectFit: aspect ? (str(block.objectFit, "cover") as "cover") : undefined, objectPosition: focalPoint(image) }}
    />
  </figure>
)}
