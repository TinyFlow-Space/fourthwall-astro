---
import { contentFor } from "@/lib/sanity/content";
const cms = contentFor(Astro.locals);
const content = cms.homePage.sections.creators;
const CREATORS_LEFT = cms.homePage.collections.CREATORS_LEFT;
const CREATORS_RIGHT = cms.homePage.collections.CREATORS_RIGHT;


import CreatorItem from "@/components/home/creator-item.astro";
import { homeContext, listItem, listSlot } from "@/lib/canvas";
const ctx = homeContext(Astro.locals);

---

<section class="creators-section pt-10 pb-surface-y-xl bg-background">
  <div class="container @container">
    <div class="text-center reveal">
      <p class="text-secondary-foreground text-body-md mb-9">
        {content.fourthwallIsForCreators}
      </p>
    </div>

    <div class="flex flex-col overflow-hidden gap-[clamp(40px,19.5px+1.43vw,56px)] py-[clamp(16px,7.8px+0.572vw,22.4px)] mask-[linear-gradient(to_right,transparent,black_6%,black_94%,transparent)] [-webkit-mask-image:linear-gradient(to_right,transparent,black_6%,black_94%,transparent)]">

      <div class="box-border will-change-transform marquee-track marquee-left" {...listSlot(ctx, "CREATORS_LEFT")}>
        {CREATORS_LEFT.map((creator) => (
          <CreatorItem creator={creator} attrs={listItem(ctx, "CREATORS_LEFT", creator)} />
        ))}
      </div>

      <div class="box-border will-change-transform marquee-track marquee-right" {...listSlot(ctx, "CREATORS_RIGHT")}>
        {CREATORS_RIGHT.map((creator) => (
          <CreatorItem creator={creator} attrs={listItem(ctx, "CREATORS_RIGHT", creator)} />
        ))}
      </div>
    </div>
  </div>
</section>
