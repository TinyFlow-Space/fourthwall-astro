---
import { contentFor } from "@/lib/sanity/content";
import { legacyHeroContent, resolveHeroContent } from "@/lib/sections/hero";
import { heroComponents } from "./hero/registry";
const cms = contentFor(Astro.locals);
const { variant, content } = resolveHeroContent(
  cms.homePage.heroVariants,
  legacyHeroContent(cms),
);
const HeroVariant = heroComponents[variant];
---

<HeroVariant content={content} />
