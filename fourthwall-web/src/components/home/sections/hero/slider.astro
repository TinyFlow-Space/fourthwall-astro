---
import { stegaClean } from "@sanity/client/stega";
import { heroBackgroundStyle, type HeroContent } from "@/lib/sections/hero";
import HeroCopy from "./copy.astro";
interface Props {
  content: HeroContent;
}
const content = Astro.props.content.slider;

import HeroSlider from "@/components/home/hero-slider.astro";
import CarouselNavButton from "@/components/ui/carousel-nav-button.astro";
---

<section
  class="hero-section z-3 bg-surface-dark text-white p-0 relative overflow-hidden"
  style={heroBackgroundStyle(content.background)}
>
  <div class="px-surface-x relative pt-24 pb-6 flex items-end justify-between gap-10 min-h-[clamp(440px,35vh+15vw,820px)]">
    <HeroCopy content={content} />

    <div class="hidden scatter-reveal scatter-reveal-rise 2md:flex gap-3 z-3">
      <CarouselNavButton
        aria-label={stegaClean(content.previousLabel)}
        variant="default"
        disabled={true}
        class="carousel-prev text-white"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          class="block h-7.5 w-7.5 -translate-px"
        >
          <path
            d="M15 6l-6 6 6 6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </CarouselNavButton>

      <CarouselNavButton
        aria-label={stegaClean(content.nextLabel)}
        variant="default"
        disabled={false}
        class="carousel-next text-white"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          class="block h-7.5 w-7.5 translate-px"
        >
          <path
            d="M9 6l6 6-6 6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </CarouselNavButton>
    </div>
  </div>

  <HeroSlider slides={content.slides} />
</section>
