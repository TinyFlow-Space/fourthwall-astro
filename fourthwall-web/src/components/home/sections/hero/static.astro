---
import { stegaClean } from "@sanity/client/stega";
import { heroBackgroundStyle, type HeroContent } from "@/lib/sections/hero";
import HeroCopy from "./copy.astro";
interface Props {
  content: HeroContent;
}
const content = Astro.props.content.static;
const MediaWrapper = content.imageHref ? "a" : "div";
---

<section
  class="hero-section z-3 bg-surface-dark text-white p-0 relative overflow-hidden"
  style={heroBackgroundStyle(content.background)}
>
  <div class="px-surface-x relative pt-24 pb-12 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-10 min-h-[clamp(440px,35vh+15vw,820px)]">
    <HeroCopy content={content} />
    {content.image && (
      <MediaWrapper
        href={content.imageHref}
        class="block w-full lg:w-2/5 shrink-0"
      >
        <img
          src={content.image}
          alt={stegaClean(content.imageAlt)}
          width="960"
          height="800"
          fetchpriority="high"
          class="block w-full h-auto object-cover rounded-lg"
        />
      </MediaWrapper>
    )}
  </div>
</section>
