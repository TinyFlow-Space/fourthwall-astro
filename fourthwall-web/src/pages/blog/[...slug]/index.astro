---
import { stegaClean } from "@sanity/client/stega";
import Newsletter from "@/components/blog/newsletter.astro";
import BlogDetailsArticle from "@/components/blog/sections/blog-details-article.astro";
import Blogs from "@/components/blog/sections/blogs.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { getPost, getRelated } from "@/lib/sanity/client";
import { imageUrl, postHref } from "@/lib/sanity/presentation";
import { isoDuration, youtubeId } from "@/lib/blog/embeds";
import type { Post, PostSummary } from "@/lib/sanity/types";
export const prerender = false;

const { slug } = Astro.params;
let post: Post | null = null;
let relatedBlogs: PostSummary[] = [];
let failed = false;

if (slug && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
  try {
    post = await getPost(slug);
  } catch {
    failed = true;
  }
}
if (post) {
  try {
    relatedBlogs = await getRelated(post);
  } catch {
    /* The article remains usable if recommendations fail. */
  }
}

Astro.response.status = failed ? 503 : post ? 200 : 404;
Astro.response.headers.set("Cache-Control", "no-store");

const title =
  post?.title ?? (failed ? "Article unavailable" : "Article not found");

const videoId = youtubeId(stegaClean(post?.video?.id));
const video =
  post?.video && videoId
    ? {
        "@type": "VideoObject",
        name: post.video.title || post.title,
        description: post.video.description || post.excerpt,
        thumbnailUrl: [
          imageUrl(post.video.thumbnail, 1280, 720) ??
            `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`,
        ],
        uploadDate: post.video.uploadDate,
        duration: isoDuration(stegaClean(post.video.duration)),
        embedUrl: `https://www.youtube.com/embed/${videoId}`,
        contentUrl: `https://www.youtube.com/watch?v=${videoId}`,
      }
    : undefined;
const postUrl = post
  ? new URL(postHref(post.slug), Astro.site ?? Astro.url).href
  : undefined;
// FAQ entries become Question/Answer pairs, matching the visible FAQ section.
const faqEntities = post?.faqs
  .filter((faq) => faq.question?.trim() && faq.answer?.trim())
  .map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  }));
const structured = post
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.title,
      description: post.excerpt,
      datePublished: post.publishedAt,
      // Prefer the editorial update date when it is later than publication.
      dateModified:
        post.effectiveDate !== post.publishedAt
          ? post.effectiveDate
          : post._updatedAt,
      image: imageUrl(post.mainImage, 1200),
      url: postUrl,
      author: post.author?.name
        ? [
            {
              "@type": "Person",
              name: post.author.name,
              url: post.author.website || undefined,
            },
          ]
        : undefined,
      video,
      abstract: post.summary?.trim() || undefined,
      mainEntity: faqEntities?.length ? faqEntities : undefined,
      mainEntityOfPage: postUrl,
    }
  : null;
---

<BaseLayout
  seo={post?.seo}
  title={`${title} | Fourthwall`}
  description={post?.excerpt ?? title}
  image={imageUrl(post?.mainImage, 1200)}
  noindex={!post}
  article={!!post}
  className="z-3 bg-background"
>
  {structured && (
    <script
      slot="head"
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(stegaClean(structured)).replace(/</g, "\\u003c")}
    />
  )}
  {post ? (
    <>
      <BlogDetailsArticle
        post={post}
        className={
          relatedBlogs.length === 0
            ? "pb-[clamp(4rem,3.3835vw+3.207rem,6.25rem)]"
            : undefined
        }
      />
      <Blogs
        posts={relatedBlogs}
        showTitle={true}
        showFilter={false}
        searchQuery=""
      />
      <Newsletter />
    </>
  ) : (
    <section class="container-lg px-6 pt-40 pb-24 text-center">
      <h1 class="text-4xl mb-6">{title}</h1>
      <p>
        {failed
          ? "We couldn’t load this article. Please try again shortly."
          : "This article may have moved or is no longer available."}
      </p>
      {failed && (
        <a href={Astro.url.pathname} class="underline mr-6">
          Try again
        </a>
      )}
      <a href="/blog" class="underline">
        Browse all posts
      </a>
    </section>
  )}
</BaseLayout>
