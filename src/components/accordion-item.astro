---
const { title } = Astro.props;
---

<div class="bg-paper-soft [transition:background_0.2s]">
  <button class="w-full py-5 px-6 gap-x-4 text-foreground text-body-md font-medium text-left cursor-pointer leading-normal border-none flex items-center justify-between">
    {title}{" "}
    <span class="size-4 text-secondary-foreground shrink-0 relative before:content-[''] before:absolute before:top-1/2 before:left-1/2 before:w-3.5 before:h-[1.5px] before:bg-current before:-translate-x-1/2 before:-translate-y-1/2 before:transition-transform before:duration-300 after:content-[''] after:absolute after:top-1/2 after:left-1/2 after:3.5 after:h-[1.5px] after:bg-current after:-translate-x-1/2 after:-translate-y-1/2 after:rotate-90 after:transition-transform after:duration-300"></span>
  </button>

  <!-- accordion content -->
  <div class="px-6 grid grid-cols-1 grid-rows-[0fr] transition-[grid-template-rows] duration-320 data-[open=true]:grid-rows-[1fr]">
    <slot />
  </div>
</div>
