---
import BlogSocialShare from "@/components/blog/blog-social-share.astro";
import type { Author } from "@/lib/sanity/types";
import { imageUrl, safeHref } from "@/lib/sanity/presentation";
interface Props {
  author: Author;
}
const { author } = Astro.props;
const avatar = imageUrl(author.image, 128, 128);
---

<div class="mt-18">
  <div class="flex flex-col md:flex-row max-[480px]:p-[1rem_1.25rem] p-8 gap-7 2md:gap-16 bg-[#0000000d]">
    <div class="flex items-start justify-start flex-none gap-5">
      {avatar && (
        <img
          src={avatar}
          width="64"
          height="64"
          loading="lazy"
          alt={author.name}
          class="w-16 rounded-full aspect-square"
        />
      )}
      <div>
        <h2 class="font-body mt-0 mb-1.5 text-lg font-normal leading-[1.6]">
          {author.name}
        </h2>
        <p class="max-w-[18ch] mb-1.5 text-base leading-[1.5] text-[#6e6e68]">
          {author.role}
        </p>
        <a
          href={safeHref(author.website)}
          target="_blank"
          class="max-w-full underline text-[#6e6e68] block"
          rel="nofollow noopener noreferrer"
        >
          <span>{safeHref(author.website) ? "Linkedin" : ""}</span>
        </a>
      </div>
    </div>

    <p class="font-body text-body-md text-foreground leading-relaxed">
      {author.bio}
    </p>
  </div>

  <BlogSocialShare className="mt-10 2md:hidden" />
</div>
