---
import { Image } from "astro:assets";
---

<article
  role="listitem"
  class="blog-card block relative transition-colors duration-150"
>
  <figure class="relative mt-0 mb-4 overflow-hidden aspect-10/6">
    <Image
      src={
        "https://fourthwall.com/webflow-cdn/63ff7c6ecc83f9ec7ffe916b/6ace8fe0187cc9529096ab7b_aimee-song-creator-spotlight.webp"
      }
      loading={"lazy"}
      inferSize
      alt={
        "Aimee Song, fashion blogger known for Song of Style, a Revolve collection, and the Amiya luxury knitwear brand."
      }
      class="size-full absolute inset-0 object-cover"
    />
  </figure>

  <div class="flex flex-col gap-2.5">
    <div class="text-[0.6875rem] leading-[1.3] tracking-[1px] text-[#6e6e68] uppercase">
      Featured
    </div>
    <h2 class="my-0 text-[clamp(1.125rem,.188vw+1.0809rem,1.25rem)] leading-[1.4] font-display font-[435] tracking-[-0.1px] text-balance">
      How Aimee Song Turned an Architecture Portfolio Into a Fashion Brand
    </h2>

    <div class="flex flex-wrap items-center justify-start gap-[clamp(0.875rem,0.5634vw+0.743rem,1.25rem)]">
      <p class="mb-0 text-[0.875rem] leading-[1.4] tracking-[-0.1px] text-[#6e6e68] text-wrap">
        Richard Lazazzera
      </p>
      <time
        datetime="2026-10-14"
        class="mb-0 text-[0.875rem] leading-[1.4] tracking-[-0.1px] text-[#6e6e68]"
      >
        Oct 14, 2026
      </time>
    </div>
  </div>

  <a
    href="/blog/aimee-song-creator-spotlight"
    class="max-w-full inline-block absolute inset-0 size-full"
  >
    <div class="sr-only">
      How Aimee Song Turned an Architecture Portfolio Into a Fashion Brand
    </div>
  </a>
</article>

<style>
  @reference "@/styles/global.css";

  @media screen and (max-width: 767px) {
    .blog-card {
      @apply grid grid-cols-[0.611111fr_0.388889fr] grid-rows-[auto_auto] items-start gap-4 border-b border-[#0000001a] pb-6 auto-cols-fr;
    }

    .blog-card figure {
      @apply order-1 mb-0;
    }
  }
</style>
