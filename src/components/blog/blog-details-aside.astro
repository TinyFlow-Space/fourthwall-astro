---
import BlogSocialShare from "@/components/blog/blog-social-share.astro";
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<aside class="block 2md:sticky top-24 max-w-full 2md:max-w-60 w-full flex-none self-start">
  <div class="text-sm leading-[1.3] font-medium mb-3">In this article:</div>

  {toc.length > 0 && (
    <nav data-toc aria-label="Table of contents" class="mb-[clamp(1.5rem,0.7519vw+1.3238rem,2rem)] flex max-h-none 2md:max-h-88 flex-col gap-2.5 2md:overflow-auto scrollbar-thin">
      {toc.map(({ depth, slug, text }) => (
        <a
          data-toc-level={`h${depth}`}
          href={`#${slug}`}
          class:list={[
            "text-sm p-0 bg-none text-[#6e6e68] transition-colors duration-200 ease-[ease] text-left leading-[1.5] hover:text-foreground",
            { "pl-3.75": depth === 3 },
          ]}
        >
          {text}
        </a>
      ))}
    </nav>
  )}

  <div class="p-5 pt-4 mb-8 bg-surface-dark text-white">
    <div class="font-display text-body-md leading-[1.25] font-[450] tracking-[-.01em] mb-3 text-wrap">
      Join our newsletter
    </div>
    <p class="max-w-[20ch] text-[#b5b3b0] text-sm leading-[1.5] mb-4 tracking-[-.00714286em] text-wrap">
      New features, product updates, trend breakdowns, and creator stories.
    </p>

    <div class="mb-0">
      <form action="" class="flex flex-col gap-2.5">
        <input
          type="email"
          name="email"
          autocomplete="email"
          aria-required={true}
          placeholder="Your email address*"
          class="rounded-lg border border-[#585954] font-body w-full text-[1em] leading-[1.5] text-center outline-none p-2.5"
        />
        <button
          type="submit"
          class="py-3 px-5 bg-background text-foreground rounded-lg font-body font-medium text-base w-full text-center block cursor-pointer wrap-break-word [word-break:break-word] m-0 border-none outline-none"
        >
          Submit
        </button>
      </form>
    </div>
  </div>

  <BlogSocialShare />
</aside>

<script>
  import { initToc } from "@/scripts/blog/toc";
  let cleanups: (() => void)[] = [];
  function initialize() {
    cleanups.forEach((cleanup) => cleanup());
    cleanups = Array.from(document.querySelectorAll<HTMLElement>("[data-toc]")).map(initToc);
  }
  initialize();
  document.addEventListener("astro:page-load", initialize);
  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((cleanup) => cleanup());
    cleanups = [];
  });
</script>

<style>
  [data-toc] a[aria-current="location"] {
    color: var(--foreground);
  }
</style>
