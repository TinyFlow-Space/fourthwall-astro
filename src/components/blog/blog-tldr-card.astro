---
interface Props {
  summary: string;
}
const { summary } = Astro.props;
const articleUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const prompt = `Please read and summarize the following article ${articleUrl.href}`;
const aiProviders = [
  {
    name: "ChatGPT",
    url: "https://chatgpt.com/",
    icon: "https://fourthwall.com/webflow-cdn/63ff7c6ecc83f97ec5fe9155/6a2fbdf6e14ef48620ad65f9_6c46ef088b26f32bab62728ad9aebade_chatGPT.svg",
  },
  {
    name: "Claude",
    url: "https://claude.ai/new",
    icon: "https://fourthwall.com/webflow-cdn/63ff7c6ecc83f97ec5fe9155/6a2fbe26373e2872bd7db05c_e24dcaf876090e0d4722c0026ea41572_claude.svg",
  },
  {
    name: "Gemini",
    url: "https://www.google.com/search?udm=50",
    icon: "https://fourthwall.com/webflow-cdn/63ff7c6ecc83f97ec5fe9155/6a2fbe35fe350642acd6c0cf_462561a3090a9eb75d349e4bd3ceb43b_gemini.svg",
  },
  {
    name: "Grok",
    url: "https://grok.com/",
    icon: "https://fourthwall.com/webflow-cdn/63ff7c6ecc83f97ec5fe9155/6a2fbe437482cb2b5699603b_bc1cf3ccbc6a5f9fa176c41587d07536_grok.svg",
  },
].map((provider) => {
  const url = new URL(provider.url);
  url.searchParams.set("q", prompt);
  return { ...provider, href: url.href };
});
---

<div class="flex flex-col gap-[clamp(1rem,.3759vw+.9119rem,1.25rem)] max-[480px]:p-[1rem_1.25rem] px-8 py-7 mb-10 bg-[#0000000d]">
  <div class="max-[480px]:contents flex items-center justify-between">
    <div class="font-display text-[clamp(20px,2vw,48px)] font-[450] max-[480px]:-order-1">
      TL;DR
    </div>
    <div class="flex items-center justify-start gap-3">
      <div class="text-[#6e6e68]">Summarize with:</div>
      {aiProviders.map((provider) => (
        <a
          rel="nofollow noopener noreferrer"
          data-ai-summarize=""
          href={provider.href}
          target="_blank"
          class="max-w-full outline-none block relative group"
        >
          <img
            width="24"
            height="24"
            alt=""
            src={provider.icon}
            loading="lazy"
            class="opacity-50 transition-opacity duration-200 group-hover:opacity-100 focus-visible:opacity-100"
          />
          <span class="pointer-events-none absolute bottom-full left-1/2 block -translate-x-1/2 rounded-md bg-surface-dark px-2 py-1 text-[0.875rem] font-medium leading-[1.5] tracking-[0.00714286em] text-white whitespace-nowrap transition-all duration-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible">
            {provider.name}
          </span>
        </a>
      ))}
    </div>
  </div>
  <p class="max-[480px]:-order-1">{summary}</p>
</div>
