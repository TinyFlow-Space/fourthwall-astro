<script>
  const overlay = document.querySelector<HTMLElement>("[data-blog-navigation]");
  let loadingTimer: ReturnType<typeof setTimeout>;
  let resetTimer: ReturnType<typeof setTimeout>;
  document.addEventListener("click", (event) => {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    )
      return;
    const link = (event.target as Element).closest<HTMLAnchorElement>(
      "a[href]",
    );
    if (
      !link ||
      link.target ||
      link.hasAttribute("download") ||
      link.matches("[data-page-link], [data-reset], [data-retry]")
    )
      return;
    const url = new URL(link.href);
    if (
      url.origin !== location.origin ||
      !/^\/blog(?:\/|$)/.test(url.pathname) ||
      (url.pathname === location.pathname && url.search === location.search)
    )
      return;
    clearTimeout(loadingTimer);
    clearTimeout(resetTimer);
    loadingTimer = setTimeout(() => {
      if (overlay) {
        const isArticle = /^\/blog\/.+/.test(url.pathname);
        const article = overlay.querySelector<HTMLElement>(
          "[data-article-skeleton]",
        );
        const listing = overlay.querySelector<HTMLElement>(
          "[data-listing-skeleton]",
        );
        if (article) article.hidden = !isArticle;
        if (listing) listing.hidden = isArticle;
        overlay.scrollTop = 0;
        overlay.hidden = false;
      }
    }, 150);
    // Restore the page if a browser navigation is stopped or fails.
    resetTimer = setTimeout(() => {
      if (overlay) overlay.hidden = true;
    }, 15000);
  });
  window.addEventListener("pageshow", () => {
    clearTimeout(loadingTimer);
    clearTimeout(resetTimer);
    if (overlay) overlay.hidden = true;
  });
</script>
<style>
  [hidden] {
    display: none !important;
  }
</style>
