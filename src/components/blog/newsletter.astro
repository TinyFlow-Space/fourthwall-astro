---
---

<section
  aria-label="Call to action"
  class="bg-background mt-0 pb-[clamp(3.5rem,6.8vw+1.9rem,7.5rem)] px-[clamp(1rem,1.5038vw+.6476rem,2rem)]"
>
  <div class="container-lg">
    <div class="flex flex-col 2md:flex-row items-start justify-between gap-5 py-[clamp(2rem,2.2556vw+1.4713rem,3.5rem)] border-t border-t-[#00000029]">
      <h2 class="max-w-[18ch] mt-0 text-[clamp(2rem,1.5038vw+1.6476rem,3rem)] leading-[1.1] font-normal tracking-[-0.64px] md:tracking-[-0.96px]">
        Keep up with the latest from Fourthwall
      </h2>

      <div class="basis-auto 2md:flex-[0_30.5rem]">
        <p class="max-w-full 2md:max-w-[42ch] mb-[clamp(1.25rem,.3759vw+1.1619rem,1.5rem)] text-wrap">
          New features, product updates, trend breakdowns, and creator stories —
          straight to your inbox.
        </p>

        <!-- form -->
        <div class="mb-4">
          <form
            action=""
            class="flex items-center justify-between border border-[#0a0a0a29] rounded-lg p-0.75"
          >
            <input
              type="email"
              placeholder="Your email address*"
              name="email"
              aria-required="true"
              autocomplete="email"
              class="flex-1 focus-within:outline-none p-2.25 pl-4 h-14"
            />
            <button
              type="submit"
              class="px-5 py-3 rounded-lg bg-surface-dark text-white cursor-pointer"
            >
              Submit
            </button>
          </form>
        </div>

        <div class="text-sm leading-[1.5] text-[#16171299]">
          You agree to receive Fourthwall marketing emails.
        </div>
      </div>
    </div>
  </div>
</section>
