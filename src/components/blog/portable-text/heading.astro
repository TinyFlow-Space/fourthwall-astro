---
import type { Block } from "@portabletext/astro/types";
import { headingId, headingText, isHeadingLevel } from "@/lib/sanity/headings";
interface Props {
  node: Block & { headingId?: string };
}
const { node } = Astro.props;
const Tag = isHeadingLevel(node.style) ? node.style : "h2";
---

<Tag id={node.headingId ?? headingId(headingText(node))}>
  <slot />
</Tag>
