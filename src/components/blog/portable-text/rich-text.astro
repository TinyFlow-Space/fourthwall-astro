---
import { PortableText } from "@portabletext/astro";
import type { BodyBlock } from "@/lib/sanity/types";
import { prepareHeadings } from "@/lib/sanity/headings";
import Heading from "./heading.astro";
import Image from "./image.astro";
import Link from "./link.astro";
interface Props {
  value: BodyBlock[];
}
const { value } = Astro.props;
const { blocks } = prepareHeadings(value);
---

<PortableText
  value={blocks}
  components={{
    block: {
      h1: Heading,
      h2: Heading,
      h3: Heading,
      h4: Heading,
      h5: Heading,
      h6: Heading,
    },
    type: { image: Image },
    mark: { link: Link },
  }}
/>
