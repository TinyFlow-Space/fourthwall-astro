---
import type { RichContentBlock } from "@/lib/sanity/types";
import { httpsUrl, videoUrl } from "@/lib/blog/embeds";
interface Props {
  node: RichContentBlock;
}
const { node } = Astro.props;
const file = httpsUrl(node.file?.url);
const src = videoUrl(node.url);
const captions = httpsUrl(node.captions?.url);
---

<figure class="my-8">
  {file ? (
    <video
      controls
      crossorigin="anonymous"
      preload="none"
      aria-label={node.title || "Article video"}
      class="w-full h-auto"
    >
      <source src={file} />
      {captions && (
        <track
          kind="captions"
          src={captions}
          srclang={node.captionLanguage || "en"}
          label="Captions"
          default
        />
      )}
      <a href={file}>Download video</a>
    </video>
  ) : src ? (
    <iframe
      src={src}
      title={node.title || "Article video"}
      loading="lazy"
      class="w-full aspect-video border-0"
      allow="fullscreen; picture-in-picture; encrypted-media"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
    />
  ) : (
    <p>Video unavailable.</p>
  )}
  {node.title && (
    <figcaption class="mt-2 text-sm text-[#6e6e68]">{node.title}</figcaption>
  )}
</figure>
