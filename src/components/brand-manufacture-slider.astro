---
import { cn } from "@/utils";
import { MGF_IMAGES, MGF_PRODUCTS } from "@/data";
import { Image } from "astro:assets";
---

<div
  data-brand-manufacture-slider
  data-current-slide="a"
  data-autoplay-delay="5200"
  class="w-full relative overflow-hidden select-none bg-surface-dark @container aspect-8/5 group"
>
  <div class="z-0 absolute inset-0 isolate">
    {MGF_IMAGES.map((image, index) => (
      <div
        data-manufacture-background={String.fromCharCode(97 + index)}
        class="bg-position-[50%] bg-cover absolute inset-0 [clip-path:inset(0px)]"
        style={{ "background-image": `url(${image})` }}
      />
    ))}
  </div>

  <div
    class="z-1 absolute inset-0 isolate [transition:transform_0.9s_var(--ease-rise-in)] group-hover:transform-[perspective(900px)_scale(var(--support-zoom,1))_rotateX(var(--tilt-x,0deg))_rotateY(var(--tilt-y,0deg))] group-hover:[transition:transform_.25s_var(--ease-rise-in)]"
    style="--tilt-y: 0deg; --tilt-x: 0deg;"
  >
    {MGF_PRODUCTS.map((product, index) => (
      <div
        data-manufacture-panel={String.fromCharCode(97 + index)}
        class="absolute top-1/2 left-1/2 flex w-[84cqi] -translate-x-1/2 -translate-y-1/2 items-center gap-x-[4.5cqi] rounded-[2.4cqi] bg-white p-[2.8cqi] [clip-path:inset(0px)]"
      >
        <div class="aspect-[1] bg-[#f4f4f4] flex-[0_0_37cqi] overflow-hidden">
          <Image
            inferSize={true}
            src={product.src}
            widths={[256, 384, 512, 640, 840]}
            sizes="(min-width: 1880px) 371px, 20vw"
            alt=""
            class="block size-full object-cover"
          />
        </div>

        <div class="flex-1 min-w-0">
          <h3 class="font-body text-[#14110f] leading-[112%] font-medium tracking-[-.01em] text-balance m-[0_0_2.7cqi] text-[2.9cqi]">
            {product.name}
          </h3>

          <div class="grid grid-cols-2 gap-x-[2cqi] gap-y-[2.3cqi]">
            {product.stats.map((stat) => (
              <div class="flex flex-col gap-y-[.6cqi]">
                <span class="text-[#9a9a9a] text-[1.7cqi]">{stat.label}</span>
                <span
                  class={cn(
                    "text-[#14110f] font-medium text-[2.5cqi]",
                    stat.isProfit && "text-[#1aa05a]",
                  )}
                >
                  ${stat.value}
                </span>
              </div>
            ))}

            <div class="flex flex-col gap-y-[.6cqi]">
              <span class="text-[#9a9a9a] text-[1.7cqi]">Status</span>
              <span class="inline-flex flex-row items-center gap-x-[1cqi] text-[2.5cqi] font-medium text-[#14110f]">
                <svg
                  viewBox="0 0 10 10"
                  aria-hidden="true"
                  class={cn(
                    "block h-[1.4cqi] w-[1.4cqi] shrink-0 overflow-visible rounded-full text-[#b4b4b4]",
                    product.status === "Delivered" && "text-[#1aa05a]",
                    product.status === "Awaiting" && "text-[#e8a93b]",
                  )}
                >
                  <circle cx="5" cy="5" r="5" fill="currentColor" />
                </svg>
                {product.status}
              </span>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import { initBrandManufactureSliders } from "@/lib/brand-manufacture-slider";

  initBrandManufactureSliders();
</script>
