---
import { BRAND_MARQUEE_DATA } from "@/data";
import { cn } from "@/utils";
import { Image } from "astro:assets";

interface Props {
  /** Auto-scroll speed in px/second, right → left. Use 0 to disable auto-scroll. */
  speed?: number;
  /** ms to ease the auto-scroll back in after a drag ends (0 = instantly). */
  resume?: number;
  /** Turn auto-scroll off when the OS has "Reduce motion" enabled. */
  respectReducedMotion?: boolean;
}

const { speed = 40, resume = 150, respectReducedMotion = false } = Astro.props;

// Repeat the data so the loop always has enough slides to stay seamless.
const MIN_SLIDES = 5;
const items = Array.from(
  { length: Math.max(BRAND_MARQUEE_DATA.length, MIN_SLIDES) },
  (_, i) => BRAND_MARQUEE_DATA[i % BRAND_MARQUEE_DATA.length],
);

// Initial layout (also the no-JS fallback): 0, 1, 2, -2, -1 …
const getPosition = (index: number) => {
  const midpoint = Math.floor(items.length / 2);
  return index - (index > midpoint ? items.length : 0);
};
---

<div
  data-brand-shop-slider
  data-speed={speed}
  data-resume={resume}
  data-respect-reduced-motion={respectReducedMotion}
  aria-hidden="true"
  class="w-full relative overflow-hidden @container bg-[#ebebec] flex-1 min-h-0 touch-pan-y overscroll-x-contain [--shop-step:51cqi] [-webkit-user-select:none] select-none aspect-8/5"
>
  <!-- Zero-height probe: lets JS read the real pixel value of --shop-step -->
  <i
    data-shop-step
    aria-hidden="true"
    class="pointer-events-none invisible absolute top-0 left-0 h-0 w-(--shop-step)"
  ></i>

  {items.map((item, index) => {
    const position = getPosition(index);

    return (
      <div
        data-shop-slide
        data-position={position}
        class={cn(
          "shop-slide absolute top-[8.5cqi] left-1/2 w-[47.5cqi] aspect-900/1260 overflow-hidden rounded-[3cqi_3cqi_0_0] will-change-transform",
        )}
        style={`--shop-position: ${position}`}
      >
        {item.type === "video" ? (
          <>
            <Image
              inferSize={true}
              src={item.bgSrc!}
              alt={item.alt}
              class="block size-full object-cover"
              loading="lazy"
              sizes="100vw"
              draggable="false"
            />

            <div class="static">
              <video
                class="absolute top-[16.27%] left-[5.333%] h-[83.33%] w-[89.333%] rounded-t-[3.2cqi] object-cover opacity-100 transition-opacity duration-600"
                src={item.src}
                muted
                loop
                playsinline
                autoplay
                preload="none"
              ></video>
            </div>

            <Image
              inferSize={true}
              src={item.actionImgSrc!}
              alt={item.alt}
              class="absolute top-[84.762%] left-[9.222%] h-auto w-[81.556%] rounded-[1.3cqi]"
              loading="lazy"
              sizes="100vw"
              draggable="false"
            />
          </>
        ) : (
          <Image
            inferSize={true}
            src={item.src}
            alt={item.alt}
            class="block size-full object-cover"
            loading="lazy"
            sizes="100vw"
            draggable="false"
          />
        )}
      </div>
    );
  })}
</div>

<script>
  const DRAG_THRESHOLD = 4; // px of movement before a press counts as a drag

  const num = (value: string | undefined, fallback: number) => {
    const n = Number(value);
    return value !== undefined && value !== "" && Number.isFinite(n)
      ? n
      : fallback;
  };

  function initBrandShopSlider(slider: HTMLElement): () => void {
    const slides = Array.from(
      slider.querySelectorAll<HTMLElement>("[data-shop-slide]"),
    );
    const probe = slider.querySelector<HTMLElement>("[data-shop-step]");
    const count = slides.length;
    if (!count || !probe) return () => {};

    const speed = num(slider.dataset.speed, 40); // px / second
    const resumeMs = num(slider.dataset.resume, 150);
    const respectReducedMotion = slider.dataset.respectReducedMotion === "true";
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const autoEnabled = () =>
      speed !== 0 && !(respectReducedMotion && motionQuery.matches);

    const base = slides.map((s) => Number(s.dataset.position) || 0);
    const half = count / 2;

    // ── The ONE piece of state. Unit = "steps" (1 step = slide width + gap).
    // Auto-scroll and dragging both write it; every slide derives from it.
    let offset = 0;
    let step = 0; // px per step, measured from the real --shop-step value
    let autoFactor = 1; // 0 → 1 ramp after a drag ends
    let rafId = 0;
    let lastTime = 0;
    let visible = true;

    let pressed = false;
    let wheeling = false; // true while a trackpad/wheel gesture is active
    let wheelTimer = 0;
    let pointerId: number | null = null;
    let startX = 0;
    let startOffset = 0;
    let dragging = false;

    const ac = new AbortController();
    const { signal } = ac;

    // Wrap into [-count/2, count/2): a slide leaving one side re-enters the
    // other while it's still far outside the viewport, so the loop never jumps.
    const wrap = (v: number) => ((((v + half) % count) + count) % count) - half;

    const render = () => {
      for (let i = 0; i < count; i++) {
        slides[i].style.transform =
          `translateX(calc(-50% + ${wrap(base[i] + offset).toFixed(5)} * var(--shop-step)))`;
      }
    };

    // Layout is read here only (mount + resize), never per frame.
    const measure = () => {
      const w = probe.getBoundingClientRect().width;
      if (w > 0) step = w;

      if (import.meta.env.DEV && step > 0) {
        const needed = (slider.clientWidth + slides[0].offsetWidth) / 2;
        if ((count / 2) * step < needed) {
          console.warn(
            "[BrandShopSlider] Not enough slides for a seamless loop at this width. Add more items.",
          );
        }
      }
      render();
    };

    const tick = (now: number) => {
      const dt = Math.min(Math.max(now - lastTime, 0), 100) / 1000; // clamp long stalls
      lastTime = now;

      // Auto-scroll is paused for the whole press (before and during a drag),
      // so the slide under the finger never drifts away from it.
      if (!pressed && !wheeling && step > 0 && autoEnabled()) {
        autoFactor =
          resumeMs > 0 ? Math.min(1, autoFactor + (dt * 1000) / resumeMs) : 1;
        offset = (offset - (speed / step) * autoFactor * dt) % count;
        render();
      }
      rafId = requestAnimationFrame(tick);
    };

    const start = () => {
      if (rafId || !visible || document.hidden) return;
      lastTime = performance.now();
      rafId = requestAnimationFrame(tick);
    };

    const stop = () => {
      cancelAnimationFrame(rafId);
      rafId = 0;
    };

    // ── Drag (shared by mouse/pen pointer events and touch events) ───────
    const press = (x: number) => {
      pressed = true;
      startX = x;
      startOffset = offset;
      dragging = false;
      autoFactor = 0; // ease back in once the press ends
    };

    const beginDrag = () => {
      dragging = true;
      slider.dataset.dragging = "true"; // CSS shows `grabbing` on hover-capable pointers
    };

    const moveTo = (x: number) => {
      // 1:1 with the pointer/finger. Drag right → content moves right.
      offset = (startOffset + (x - startX) / step) % count;
      render();
    };

    const release = () => {
      if (!pressed) return;
      pressed = false;
      dragging = false;
      lastTime = performance.now(); // no dt spike; offset stays where the user left it
      delete slider.dataset.dragging;
    };

    // Mouse / pen / touch screen (touch-action: pan-y keeps vertical page scroll)
    slider.addEventListener(
      "pointerdown",
      (e) => {
        if (!e.isPrimary || e.button !== 0) return;
        pointerId = e.pointerId;
        press(e.clientX);
      },
      { signal },
    );

    slider.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerId !== pointerId || !pressed || step <= 0) return;
        if (!dragging) {
          if (Math.abs(e.clientX - startX) < DRAG_THRESHOLD) return;
          beginDrag();
          try {
            slider.setPointerCapture(e.pointerId);
          } catch {
            /* pointer already gone: keep dragging without capture */
          }
        }
        moveTo(e.clientX);
      },
      { signal },
    );

    const endPointer = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      pointerId = null;
      try {
        slider.releasePointerCapture(e.pointerId);
      } catch {
        /* already released */
      }
      release();
    };

    slider.addEventListener("pointerup", endPointer, { signal });
    slider.addEventListener("pointercancel", endPointer, { signal });
    slider.addEventListener("dragstart", (e) => e.preventDefault(), { signal });

    // Two-finger trackpad / horizontal wheel: arrives as `wheel` events with
    // deltaX. Same `offset`, so it behaves exactly like a drag. The OS supplies
    // the momentum as trailing wheel events, so no inertia code is needed.
    const WHEEL_IDLE_MS = 140; // gesture counts as finished after this much silence
    slider.addEventListener(
      "wheel",
      (e) => {
        if (step <= 0) return;
        // Lock the axis for the whole gesture so stray deltaY noise from a
        // horizontal swipe can't scroll the page; clearly vertical gestures pass through.
        if (!wheeling && Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;

        if (e.cancelable) e.preventDefault(); // also blocks browser back/forward swipe

        const unit =
          e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? slider.clientWidth : 1;
        // Swipe left (deltaX > 0) → content moves left, like a drag to the left.
        offset = (offset - (e.deltaX * unit) / step) % count;
        render();

        wheeling = true;
        autoFactor = 0; // ease back in after the gesture ends
        clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(() => {
          wheeling = false;
          lastTime = performance.now();
        }, WHEEL_IDLE_MS);
      },
      { signal, passive: false },
    );

    // ── Lifecycle ────────────────────────────────────────────────────────
    const ro = new ResizeObserver(measure);
    ro.observe(slider);

    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        visible ? start() : stop();
      },
      { rootMargin: "100px" },
    );
    io.observe(slider);

    document.addEventListener(
      "visibilitychange",
      () => (document.hidden ? stop() : start()),
      { signal },
    );

    measure();
    start();
    slider.dataset.sliderReady = "true"; // handy DevTools check that the script ran

    return () => {
      stop();
      clearTimeout(wheelTimer);
      ro.disconnect();
      io.disconnect();
      ac.abort();
      delete slider.dataset.sliderReady;
      delete slider.dataset.dragging;
    };
  }

  // Works with and without Astro view transitions (<ClientRouter />).
  const instances = new Map<HTMLElement, () => void>();

  const mountAll = () => {
    document
      .querySelectorAll<HTMLElement>("[data-brand-shop-slider]")
      .forEach((el) => {
        if (!instances.has(el)) instances.set(el, initBrandShopSlider(el));
      });
  };

  const unmountAll = () => {
    instances.forEach((destroy) => destroy());
    instances.clear();
  };

  mountAll();
  document.addEventListener("astro:page-load", mountAll);
  document.addEventListener("astro:before-swap", unmountAll);
</script>

<style>
  .shop-slide {
    /* SSR / no-JS fallback. JS overrides it inline with the same formula. */
    transform: translateX(calc(-50% + var(--shop-position) * var(--shop-step)));
    /* Slides never intercept the pointer, so drags always start on the slider */
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    [data-brand-shop-slider] {
      cursor: grab;
    }

    [data-brand-shop-slider][data-dragging="true"] {
      cursor: grabbing;
    }
  }
</style>
