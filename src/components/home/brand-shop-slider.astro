---
import { BRAND_MARQUEE_DATA } from "@/data/home/sliders";
import { cn } from "@/utils";
import { Image } from "astro:assets";

interface Props {
  /** Scroll speed in px/s; 0 disables autoplay. */
  speed?: number;
  /** Autoplay resume duration in ms; 0 resumes immediately. */
  resume?: number;
  /** Disable autoplay for reduced motion. */
  respectReducedMotion?: boolean;
}

const { speed = 40, resume = 150, respectReducedMotion = false } = Astro.props;

// Repeat slides to fill the loop.
const MIN_SLIDES = 5;
const items = Array.from(
  { length: Math.max(BRAND_MARQUEE_DATA.length, MIN_SLIDES) },
  (_, i) => BRAND_MARQUEE_DATA[i % BRAND_MARQUEE_DATA.length],
);

// Center slides before JavaScript loads.
const getPosition = (index: number) => {
  const midpoint = Math.floor(items.length / 2);
  return index - (index > midpoint ? items.length : 0);
};
---

<div
  data-speed={speed}
  data-resume={resume}
  data-respect-reduced-motion={respectReducedMotion}
  aria-hidden="true"
  class="brand-shop-slider w-full relative overflow-hidden @container bg-[#ebebec] flex-1 min-h-0 touch-pan-y overscroll-x-contain [--shop-step:51cqi] [-webkit-user-select:none] select-none aspect-8/5"
>
  <!-- Measure --shop-step in pixels. -->
  <i
    aria-hidden="true"
    class="shop-step pointer-events-none invisible absolute top-0 left-0 h-0 w-(--shop-step)"
  ></i>

  {items.map((item, index) => {
    const position = getPosition(index);

    return (
      <div
        data-position={position}
        class={cn(
          "shop-slide absolute top-[8.5cqi] left-1/2 w-[47.5cqi] aspect-900/1260 overflow-hidden rounded-[3cqi_3cqi_0_0] will-change-transform",
        )}
        style={`--shop-position: ${position}`}
      >
        {item.type === "video" ? (
          <>
            <Image
              inferSize={true}
              src={item.bgSrc!}
              alt={item.alt}
              class="block size-full object-cover"
              loading="lazy"
              widths={[270, 400, 540, 720, 900]}
              sizes="(min-width: 1880px) 408px, 21vw"
              draggable="false"
            />

            <div class="static">
              <video
                class="absolute top-[16.27%] left-[5.333%] h-[83.33%] w-[89.333%] rounded-t-[3.2cqi] object-cover opacity-100 transition-opacity duration-600"
                src={item.src}
                muted
                loop
                playsinline
                autoplay
                preload="none"
              ></video>
            </div>

            <Image
              inferSize={true}
              src={item.actionImgSrc!}
              alt={item.alt}
              class="absolute top-[84.762%] left-[9.222%] h-auto w-[81.556%] rounded-[1.3cqi]"
              loading="lazy"
              widths={[270, 400, 540, 720, 900]}
              sizes="(min-width: 1880px) 408px, 21vw"
              draggable="false"
            />
          </>
        ) : (
          <Image
            inferSize={true}
            src={item.src}
            alt={item.alt}
            class="block size-full object-cover"
            loading="lazy"
            widths={[270, 400, 540, 720, 900]}
            sizes="(min-width: 1880px) 408px, 21vw"
            draggable="false"
          />
        )}
      </div>
    );
  })}
</div>

<script>
  const DRAG_THRESHOLD = 4; // Drag threshold in px.

  const num = (value: string | undefined, fallback: number) => {
    const n = Number(value);
    return value !== undefined && value !== "" && Number.isFinite(n)
      ? n
      : fallback;
  };

  function initBrandShopSlider(slider: HTMLElement): () => void {
    const slides = Array.from(
      slider.querySelectorAll<HTMLElement>(".shop-slide"),
    );
    const probe = slider.querySelector<HTMLElement>(".shop-step");
    const count = slides.length;
    if (!count || !probe) return () => {};

    const speed = num(slider.dataset.speed, 40); // px / second
    const resumeMs = num(slider.dataset.resume, 150);
    const respectReducedMotion = slider.dataset.respectReducedMotion === "true";
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const autoEnabled = () =>
      speed !== 0 && !(respectReducedMotion && motionQuery.matches);

    const base = slides.map((s) => Number(s.dataset.position) || 0);
    const half = count / 2;

    // Shared position for dragging and autoplay, in slide-width steps.
    let offset = 0;
    let step = 0; // Slide width plus gap, in px.
    let autoFactor = 1; // Autoplay ramp after dragging.
    let rafId = 0;
    let lastTime = 0;
    let visible = true;

    let pressed = false;
    let wheeling = false; // Wheel gesture in progress.
    let wheelTimer = 0;
    let pointerId: number | null = null;
    let startX = 0;
    let startOffset = 0;
    let dragging = false;

    const ac = new AbortController();
    const { signal } = ac;

    // Wrap slides outside the viewport to hide loop resets.
    const wrap = (v: number) => ((((v + half) % count) + count) % count) - half;

    const render = () => {
      for (let i = 0; i < count; i++) {
        slides[i].style.transform =
          `translateX(calc(-50% + ${wrap(base[i] + offset).toFixed(5)} * var(--shop-step)))`;
      }
    };

    // Measure on mount and resize only.
    const measure = () => {
      const w = probe.getBoundingClientRect().width;
      if (w > 0) step = w;

      if (import.meta.env.DEV && step > 0) {
        const needed = (slider.clientWidth + slides[0].offsetWidth) / 2;
        if ((count / 2) * step < needed) {
          console.warn(
            "[BrandShopSlider] Not enough slides for a seamless loop at this width. Add more items.",
          );
        }
      }
      render();
    };

    const tick = (now: number) => {
      const dt = Math.min(Math.max(now - lastTime, 0), 100) / 1000; // clamp long stalls
      lastTime = now;

      // Pause while pressed so the slide stays under the pointer.
      if (!pressed && !wheeling && step > 0 && autoEnabled()) {
        autoFactor =
          resumeMs > 0 ? Math.min(1, autoFactor + (dt * 1000) / resumeMs) : 1;
        offset = (offset - (speed / step) * autoFactor * dt) % count;
        render();
      }
      rafId = requestAnimationFrame(tick);
    };

    const start = () => {
      if (rafId || !visible || document.hidden) return;
      lastTime = performance.now();
      rafId = requestAnimationFrame(tick);
    };

    const stop = () => {
      cancelAnimationFrame(rafId);
      rafId = 0;
    };

    const press = (x: number) => {
      pressed = true;
      startX = x;
      startOffset = offset;
      dragging = false;
      autoFactor = 0; // Resume gradually after release.
    };

    const beginDrag = () => {
      dragging = true;
      slider.dataset.dragging = "true"; // Enable the grabbing cursor.
    };

    const moveTo = (x: number) => {
      // Move slides with the pointer.
      offset = (startOffset + (x - startX) / step) % count;
      render();
    };

    const release = () => {
      if (!pressed) return;
      pressed = false;
      dragging = false;
      lastTime = performance.now(); // Avoid a time jump after dragging.
      delete slider.dataset.dragging;
    };

    // Allow vertical page scrolling during touch gestures.
    slider.addEventListener(
      "pointerdown",
      (e) => {
        if (!e.isPrimary || e.button !== 0) return;
        pointerId = e.pointerId;
        press(e.clientX);
      },
      { signal },
    );

    slider.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerId !== pointerId || !pressed || step <= 0) return;
        if (!dragging) {
          if (Math.abs(e.clientX - startX) < DRAG_THRESHOLD) return;
          beginDrag();
          try {
            slider.setPointerCapture(e.pointerId);
          } catch {
            /* Pointer capture is no longer available. */
          }
        }
        moveTo(e.clientX);
      },
      { signal },
    );

    const endPointer = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      pointerId = null;
      try {
        slider.releasePointerCapture(e.pointerId);
      } catch {
        /* Pointer capture was already released. */
      }
      release();
    };

    slider.addEventListener("pointerup", endPointer, { signal });
    slider.addEventListener("pointercancel", endPointer, { signal });
    slider.addEventListener("dragstart", (e) => e.preventDefault(), { signal });

    // Use wheel deltas directly; the OS supplies momentum.
    const WHEEL_IDLE_MS = 140; // Wheel idle timeout in ms.
    slider.addEventListener(
      "wheel",
      (e) => {
        if (step <= 0) return;
        // Lock horizontal gestures; let vertical scrolling pass through.
        if (!wheeling && Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;

        if (e.cancelable) e.preventDefault(); // Prevent browser swipe navigation.

        const unit =
          e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? slider.clientWidth : 1;
        // Match the drag direction.
        offset = (offset - (e.deltaX * unit) / step) % count;
        render();

        wheeling = true;
        autoFactor = 0; // Resume gradually after the gesture.
        clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(() => {
          wheeling = false;
          lastTime = performance.now();
        }, WHEEL_IDLE_MS);
      },
      { signal, passive: false },
    );

    const ro = new ResizeObserver(measure);
    ro.observe(slider);

    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        visible ? start() : stop();
      },
      { rootMargin: "100px" },
    );
    io.observe(slider);

    document.addEventListener(
      "visibilitychange",
      () => (document.hidden ? stop() : start()),
      { signal },
    );

    measure();
    start();
    slider.dataset.sliderReady = "true";

    return () => {
      stop();
      clearTimeout(wheelTimer);
      ro.disconnect();
      io.disconnect();
      ac.abort();
      delete slider.dataset.sliderReady;
      delete slider.dataset.dragging;
    };
  }

  // Reinitialize after Astro navigation.
  const instances = new Map<HTMLElement, () => void>();

  const mountAll = () => {
    document
      .querySelectorAll<HTMLElement>(".brand-shop-slider")
      .forEach((el) => {
        if (!instances.has(el)) instances.set(el, initBrandShopSlider(el));
      });
  };

  const unmountAll = () => {
    instances.forEach((destroy) => destroy());
    instances.clear();
  };

  mountAll();
  document.addEventListener("astro:page-load", mountAll);
  document.addEventListener("astro:before-swap", unmountAll);
</script>

<style>
  .shop-slide {
    /* Initial position before JavaScript loads. */
    transform: translateX(calc(-50% + var(--shop-position) * var(--shop-step)));
    /* Let the slider handle drag events. */
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .brand-shop-slider {
      cursor: grab;
    }

    .brand-shop-slider[data-dragging="true"] {
      cursor: grabbing;
    }
  }
</style>
