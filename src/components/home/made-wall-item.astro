---
import type { WALL_SHOPS } from "@/data/home/wall-shops";
interface Props {
  shop: (typeof WALL_SHOPS)[number];
}
const { shop } = Astro.props;
---

<a
  class="made-wall-item absolute left-0 top-0 ml-[calc(var(--w)/-2)] mt-[calc(var(--h)/-2)] w-(--w,220px) h-(--h,150px) will-change-transform no-underline invisible backface-hidden hover:z-10 group cursor-none!"
  href={shop.href}
  target="_blank"
  rel="noopener noreferrer"
  draggable="false"
  data-name={shop.name}
>
  <div class="absolute inset-0 overflow-hidden bg-[#141414] transform-[scale(1)] origin-center transition-transform duration-350 ease-rise-in backface-hidden group-hover:transform-[scale(1.12)]">
    <img
      class="block h-full w-full object-cover object-top opacity-100 pointer-events-none transition-[opacity_.25s_ease] [-webkit-user-drag:none] backface-hidden group-hover:opacity-100"
      src={shop.src}
      alt={`Shop — ${shop.name}`}
      draggable="false"
      loading="lazy"
      decoding="async"
    />
  </div>
</a>
