---
import HeroSlider from "@/components/home/hero-slider.astro";
import CarouselNavButton from "@/components/ui/carousel-nav-button.astro";
---

<section class="hero-section z-3 bg-surface-dark text-white p-0 relative overflow-hidden">
  <!-- top content -->
  <div class="px-surface-x relative pt-24 pb-6 flex items-end justify-between gap-10 min-h-[clamp(440px,35vh+15vw,820px)]">
    <div class="relative flex flex-col items-start text-left">
      <h1 class="rise-in max-w-[28ch] font-display font-[420] text-heading-xl leading-flat text-balance normal-case my-0 p-0 tracking-[-0.02em] [animation-delay:100ms]">
        One platform for premium products and branded shops.{" "}
        <span class="text-muted-foreground">Easy to start. Ready to grow.</span>
      </h1>

      <div class="rise-in [animation-delay:300ms] mt-[clamp(36px,1.8vw,56px)] flex items-center flex-wrap gap-6">
        <a
          href="https://fourthwall.com/get-started"
          class="link-underline inline-flex items-center gap-2.5 font-body text-body-md py-4.5 px-7 rounded-lg bg-background text-foreground max-w-full font-medium group"
        >
          <div class="h-[1.12em] leading-tight align-bottom inline-block overflow-hidden">
            <span class="text-motion group-hover:-translate-y-full">
              Start now
            </span>
            <span class="text-motion group-hover:-translate-y-full">
              Start now
            </span>
          </div>
        </a>

        <p class="text-muted-foreground text-body-md">
          No upfront costs. No credit card required.
        </p>
      </div>
    </div>

    <!--  NEXT/PREV buttons -->
    <div class="hidden scatter-reveal scatter-reveal-rise 2md:flex gap-3 z-3">
      <CarouselNavButton
        aria-label="Previous"
        variant="default"
        disabled={true}
        class="carousel-prev text-white"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          class="block h-7.5 w-7.5 -translate-px"
        >
          <path
            d="M15 6l-6 6 6 6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </CarouselNavButton>

      <CarouselNavButton
        aria-label="Next"
        variant="default"
        disabled={false}
        class="carousel-next text-white"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          class="block h-7.5 w-7.5 translate-px"
        >
          <path
            d="M9 6l6 6-6 6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </CarouselNavButton>
    </div>
  </div>

  <!-- bottom slider -->
  <HeroSlider />
</section>
