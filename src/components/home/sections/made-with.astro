---
import { WALL_SHOPS } from "@/data/home/wall-shops";
import MadeWallItem from "@/components/home/made-wall-item.astro";

interface Props {
  /** Rotation speed in degrees/s; positive rotates right, 0 stops. */
  speed?: number;
  /** Autoplay resume duration in ms; 0 resumes immediately. */
  resume?: number;
  /** Disable autoplay for reduced motion. */
  respectReducedMotion?: boolean;
}

const { speed = 0.4, resume = 150, respectReducedMotion = false } = Astro.props;
---

<section class="bg-background">
  <div
    data-speed={speed}
    data-resume={resume}
    data-respect-reduced-motion={respectReducedMotion}
    class="made-wall-section [--gutter:80px] max-[992px]:[--gutter:40px] w-[calc(100%-var(--gutter)+var(--expand-progress)*var(--gutter))] max-w-[calc(1880px+var(--expand-progress)*(100vw-1880px))] select-none touch-pan-y overscroll-x-contain [-webkit-user-select:none] pt-surface-y-lg bg-surface-dark text-white cursor-grab mx-auto pb-0 overflow-hidden"
    style={{ "--expand-progress": "0.0000" }}
  >
    <div class="max-w-[1880px] px-surface-x text-center mx-auto">
      <h2 class="font-display text-white text-heading-xl leading-flat font-[420] tracking-[-.02em] mb-0 p-0 text-balance reveal">
        Made with Fourthwall
      </h2>
    </div>

    <div class="made-wall-stage relative mt-[clamp(24px,3.8vw,96px)] [--stage-default-h:clamp(440px,calc(310px+25vw),1120px)] [--stage-expanded-h:clamp(560px,calc(380px+30vw),1400px)] h-[calc(var(--stage-default-h)+var(--expand-progress)*(var(--stage-expanded-h)-var(--stage-default-h)))] perspective-[clamp(1500px,calc(1275px+37.5vw),3200px)] mask-none [-webkit-mask-image:none] touch-pan-y [-webkit-user-select:none] w-full perspective-origin-[50%_center] isolate overflow-hidden mb-0 mx-0">

      <div
        class="stage-frame absolute top-1/2 left-1/2 h-0 w-0 transform-3d will-change-transform"
        style="transform: translate(-50%, -50%) rotateX(0deg) rotateY(0deg);"
      >

        <div class="made-wall-items absolute top-0 left-0 h-0 w-0 transform-3d">
          {Array.from({ length: 72 }).map((_, index) => (
            <MadeWallItem shop={WALL_SHOPS[index % WALL_SHOPS.length]} />
          ))}
        </div>
      </div>
    </div>

    <div
      aria-hidden="true"
      class="made-wall-cursor fixed top-0 left-0 z-30 pointer-events-none invisible opacity-0 whitespace-nowrap bg-white text-foreground rounded-full px-4 py-1.5 text-body-md font-medium"
    ></div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { initSectionExpansion } from "@/scripts/animations/section-expansion";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { initCursorTracking } from "@/scripts/animations/cursor-tracking";

  gsap.registerPlugin(ScrollTrigger);

  const TILE_W = 0.255; // 25.5% of viewport width.
  const TILE_ASPECT = 68 / 43; // Source image aspect ratio.
  const GAP = 0.02; // Tile gap, relative to viewport width.
  const TOP_PAD = 1 / 60; // Top padding, relative to viewport width.
  const COLUMNS = 24; // 24 tiles per ring, 15° apart.
  const CULL_MARGIN = 0.1; // Offscreen buffer, relative to viewport width.
  const MAX_VELOCITY = 600; // Maximum fling speed in degrees/s.
  const FRICTION_TAU = 0.19; // Momentum decay time in seconds.
  const DRAG_THRESHOLD = 4; // Drag threshold in px.
  const WHEEL_IDLE_MS = 140; // Wheel idle timeout in ms.
  const RAD = Math.PI / 180;

  const num = (value: string | undefined, fallback: number) => {
    const n = Number(value);
    return value !== undefined && value !== "" && Number.isFinite(n)
      ? n
      : fallback;
  };

  // Wrap angles to [-180, 180).
  const wrap180 = (a: number) => ((((a + 180) % 360) + 360) % 360) - 180;

  function initWallMotion(
    section: HTMLElement,
    stage: HTMLElement,
    wall: HTMLElement,
    items: HTMLElement[],
  ): () => void {
    const count = items.length;
    const speed = num(section.dataset.speed, 0.4); // deg / s
    const resumeMs = num(section.dataset.resume, 150);
    const respectReducedMotion =
      section.dataset.respectReducedMotion === "true";
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const autoEnabled = () =>
      speed !== 0 && !(respectReducedMotion && motionQuery.matches);

    const stepDeg = 360 / COLUMNS;

    // Cache tile angles and rows.
    const row = items.map((_, i) => Math.floor(i / COLUMNS));
    const baseDeg = items.map(
      (_, i) => (i % COLUMNS) * stepDeg + (row[i] % 2) * (stepDeg / 2),
    ); // brick stagger

    // Recalculate geometry on resize.
    let vw = 0;
    let tileW = 0;
    let tileH = 0;
    let radius = 1; // ring radius (px)
    let persp = 1500; // Perspective in px.
    let stageW = 0;
    let stageH = 0;
    let rowY: number[] = []; // Row centers in px.
    let degPerPx = 0; // Degrees per pixel of pointer movement.

    const layout = () => {
      // Anchor the first row so expansion reveals rows without moving them.
      const tileGap = vw * GAP;
      const y0 = -stageH / 2 + vw * TOP_PAD + tileH / 2;
      rowY = items.map((_, i) => y0 + row[i] * (tileH + tileGap));
    };

    const measureViewport = () => {
      vw = document.documentElement.clientWidth;
      tileW = vw * (vw < 768 ? 0.64 : vw < 992 ? 0.42 : TILE_W);
      tileH = tileW / TILE_ASPECT;
      const pitch = tileW + vw * GAP;
      radius = pitch / (2 * Math.sin((stepDeg * RAD) / 2));
      degPerPx = 1 / (radius * RAD);
      persp = parseFloat(getComputedStyle(stage).perspective) || 1500;
      wall.style.setProperty("--w", `${tileW}px`);
      wall.style.setProperty("--h", `${tileH}px`);
      layout();
      render(true);
    };

    // Share one angle across autoplay and gestures.
    let angle = 0;
    let velocity = 0; // deg/s fling momentum
    let autoFactor = 1;
    let rafId = 0;
    let lastTime = 0;
    let visible = true;
    let pressed = false;
    let wheeling = false;
    let wheelTimer = 0;
    let dragging = false;
    let suppressClick = false;
    let pointerId: number | null = null;
    let startX = 0;
    let startAngle = 0;
    let samples: { t: number; a: number }[] = [];

    const isVisible = new Array<boolean>(count).fill(false);
    const ac = new AbortController();
    const { signal } = ac;

    // Skip tiles facing away or outside the stage.
    const shouldShow = (
      i: number,
      s: number,
      c: number,
      X: number,
      Z: number,
    ) => {
      // Check that the tile faces the camera.
      if (-X * s + (persp - Z) * c <= 0) return false;

      // Check projected horizontal bounds.
      const hw = tileW / 2;
      const margin = vw * CULL_MARGIN;
      const halfW = stageW / 2 + margin;
      const zl = Z + hw * s;
      const zr = Z - hw * s;
      const xl = ((X - hw * c) * persp) / (persp - zl);
      const xr = ((X + hw * c) * persp) / (persp - zr);
      if (Math.max(xl, xr) < -halfW || Math.min(xl, xr) > halfW) return false;

      // Skip rows outside the stage.
      const k = persp / (persp - Z);
      const top = (rowY[i] - tileH / 2) * k;
      const bottom = (rowY[i] + tileH / 2) * k;
      const halfH = stageH / 2 + margin;
      return !(bottom < -halfH || top > halfH);
    };

    let dirty = true;
    const render = (force = false) => {
      if (!force && !dirty) return;
      dirty = false;
      for (let i = 0; i < count; i++) {
        const deg = wrap180(baseDeg[i] + angle);
        const th = deg * RAD;
        const s = Math.sin(th);
        const c = Math.cos(th);
        const X = radius * s;
        const Z = radius * c - radius;
        const show = shouldShow(i, s, c, X, Z);

        if (show) {
          items[i].style.transform =
            `translate3d(${X.toFixed(1)}px, ${rowY[i].toFixed(1)}px, ${Z.toFixed(1)}px) rotateY(${deg.toFixed(2)}deg)`;
        }
        if (show !== isVisible[i]) {
          isVisible[i] = show;
          items[i].style.visibility = show ? "visible" : "hidden";
        }
      }
    };

    const setAngle = (a: number) => {
      angle = a % 360;
      dirty = true;
    };

    const tick = (now: number) => {
      const dt = Math.min(Math.max(now - lastTime, 0), 100) / 1000;
      lastTime = now;

      if (!pressed && !wheeling) {
        let delta = 0;

        // Apply momentum.
        if (velocity !== 0) {
          delta += velocity * dt;
          velocity *= Math.exp(-dt / FRICTION_TAU);
          if (Math.abs(velocity) < 0.02) velocity = 0;
        }

        // Resume autoplay.
        if (autoEnabled()) {
          autoFactor =
            resumeMs > 0 ? Math.min(1, autoFactor + (dt * 1000) / resumeMs) : 1;
          delta += speed * autoFactor * dt;
        }

        if (delta !== 0) setAngle(angle + delta);
      }

      render();
      rafId = requestAnimationFrame(tick);
    };

    const start = () => {
      if (rafId || !visible || document.hidden) return;
      lastTime = performance.now();
      rafId = requestAnimationFrame(tick);
    };
    const stop = () => {
      cancelAnimationFrame(rafId);
      rafId = 0;
    };

    const flingVelocity = () => {
      const now = performance.now();
      const last = samples[samples.length - 1];
      if (!last || now - last.t > 80 || samples.length < 2) return 0; // No fling after holding still.
      const first = samples[0];
      const dt = (last.t - first.t) / 1000;
      if (dt <= 0) return 0;
      const v = (last.a - first.a) / dt;
      return Math.max(-MAX_VELOCITY, Math.min(MAX_VELOCITY, v));
    };

    section.addEventListener(
      "pointerdown",
      (e) => {
        if (!e.isPrimary || e.button !== 0) return;
        pointerId = e.pointerId;
        pressed = true;
        dragging = false;
        suppressClick = false;
        startX = e.clientX;
        startAngle = angle;
        velocity = 0; // Stop momentum on press.
        autoFactor = 0; // Resume gradually after release.
        samples = [];
      },
      { signal },
    );

    section.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerId !== pointerId || !pressed || degPerPx <= 0) return;
        const dx = e.clientX - startX;

        if (!dragging) {
          if (Math.abs(dx) < DRAG_THRESHOLD) return;
          dragging = true;
          section.dataset.dragging = "true";
          try {
            section.setPointerCapture(e.pointerId);
          } catch {
            /* Pointer capture is no longer available. */
          }
        }

        // Rotate with the pointer.
        setAngle(startAngle + dx * degPerPx);
        const now = performance.now();
        samples.push({ t: now, a: angle });
        while (samples.length > 2 && now - samples[0].t > 100) samples.shift();
      },
      { signal },
    );

    const endPointer = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      pointerId = null;
      try {
        section.releasePointerCapture(e.pointerId);
      } catch {
        /* Pointer capture was already released. */
      }
      if (!pressed) return;
      pressed = false;
      lastTime = performance.now();
      if (dragging) {
        velocity = flingVelocity();
        dragging = false;
        suppressClick = true; // Prevent link clicks after dragging.
        window.setTimeout(() => (suppressClick = false), 350);
        delete section.dataset.dragging;
      }
      samples = [];
    };

    section.addEventListener("pointerup", endPointer, { signal });
    section.addEventListener("pointercancel", endPointer, { signal });
    section.addEventListener("dragstart", (e) => e.preventDefault(), {
      signal,
    });
    section.addEventListener(
      "click",
      (e) => {
        if (!suppressClick) return;
        e.preventDefault();
        e.stopPropagation();
        suppressClick = false;
      },
      { signal, capture: true },
    );

    // Use the wheel momentum supplied by the OS.
    section.addEventListener(
      "wheel",
      (e) => {
        if (degPerPx <= 0) return;
        // Lock horizontal gestures; allow vertical scrolling.
        if (!wheeling && Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
        if (e.cancelable) e.preventDefault(); // Prevent browser swipe navigation.

        const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? vw : 1;
        // Match the drag direction.
        setAngle(angle - e.deltaX * unit * degPerPx);

        wheeling = true;
        velocity = 0;
        autoFactor = 0;
        clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(() => {
          wheeling = false;
          lastTime = performance.now();
        }, WHEEL_IDLE_MS);
      },
      { signal, passive: false },
    );

    const ro = new ResizeObserver(([entry]) => {
      // Read stage size from the expansion state.
      stageW = entry.contentRect.width;
      stageH = entry.contentRect.height;
      layout();
      dirty = true;
      if (!rafId) render();
    });
    ro.observe(stage);

    const onResize = () => measureViewport();
    window.addEventListener("resize", onResize, { signal });

    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        visible ? start() : stop();
      },
      { rootMargin: "100px" },
    );
    io.observe(section);

    document.addEventListener(
      "visibilitychange",
      () => (document.hidden ? stop() : start()),
      { signal },
    );

    stageW = stage.clientWidth;
    stageH = stage.clientHeight;
    measureViewport();
    start();
    section.dataset.wallReady = "true";

    return () => {
      stop();
      clearTimeout(wheelTimer);
      ro.disconnect();
      io.disconnect();
      ac.abort();
      delete section.dataset.wallReady;
      delete section.dataset.dragging;
    };
  }

  const cleanups = new WeakMap<HTMLElement, () => void>();

  const initializeMadeWall = () => {
    document
      .querySelectorAll<HTMLElement>(".made-wall-section")
      .forEach((section) => {
        if (cleanups.has(section)) return;

        const stage = section.querySelector<HTMLElement>(".made-wall-stage");
        const wall = section.querySelector<HTMLElement>(".made-wall-items");
        const cursor = section.querySelector<HTMLElement>(".made-wall-cursor");
        const items = Array.from(
          wall?.querySelectorAll<HTMLElement>(".made-wall-item") ?? [],
        );

        if (!stage || !wall || !cursor || !items.length) return;

        const disposeExpansion = initSectionExpansion(section, stage, 0.8);

        const cursorCleanup = initCursorTracking(
          section,
          ".made-wall-item",
          cursor,
          "data-name",
        );

        const wallCleanup = initWallMotion(section, stage, wall, items);

        const cleanup = () => {
          disposeExpansion();
          cursorCleanup();
          wallCleanup();
        };

        cleanups.set(section, cleanup);
      });
  };

  const disposeMadeWall = () => {
    document
      .querySelectorAll<HTMLElement>(".made-wall-section")
      .forEach((section) => {
        cleanups.get(section)?.();
        cleanups.delete(section);
      });
  };

  document.addEventListener("astro:page-load", initializeMadeWall);
  document.addEventListener("astro:before-swap", disposeMadeWall);
  initializeMadeWall();
</script>

<style>
  @media (hover: hover) and (pointer: fine) {
    .made-wall-section[data-dragging="true"],
    .made-wall-section[data-dragging="true"] :global(*) {
      cursor: grabbing !important;
    }
  }
</style>
