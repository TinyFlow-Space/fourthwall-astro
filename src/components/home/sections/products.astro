---
import { CATALOG_PRODUCTS } from "@/data/products/catalog-products";
import FilterButtons from "@/components/ui/filter-buttons.astro";
import ProductCard from "@/components/products/product-card.astro";

const FILTERS = [
  "Bestsellers",
  "Apparel",
  "Accessories",
  "Drinkware",
  "Home & Living",
];
---

<section class="products-section px-surface-x pt-surface-y-sm pb-surface-y-lg bg-background">
  <div class="container @container">
    <div class="mb-10 max-w-[88ch] reveal">
      <h2 class="font-display text-foreground text-heading-lg leading-tight font-[435] normal-case my-0 p-0">
        Hundreds of products.
        <span class="text-secondary-foreground"> No minimums.</span>
      </h2>
    </div>

    <div class="flex items-center gap-14 mb-12">
      <div class="mb-0 flex-[1_1_0%] min-w-0 relative">
        <FilterButtons
          items={FILTERS}
          selected="Bestsellers"
          label="Product categories"
        />
      </div>
      <div class="flex-none ml-auto">
        <a
          href="https://products.fourthwall.com"
          class="btn-secondary z-0 max-w-full py-4.5 px-7 inline-flex items-center gap-2.5 rounded-lg text-foreground text-body-md font-medium transition-[background-color_.2s,border-color_.2s] no-underline group"
        >
          <div class="h-[1.12em] leading-tight align-bottom inline-block overflow-hidden">
            <span class="text-motion group-hover:-translate-y-full">
              Browse all
            </span>
            <span class="text-motion group-hover:-translate-y-full">
              Browse all
            </span>
          </div>
        </a>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-1 gap-y-10 row-auto">
      {CATALOG_PRODUCTS.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
    <a
      class="mobile-catalog-browse btn-secondary min-[768px]:max-[992px]:w-fit min-[768px]:max-[992px]:mx-auto"
      href="https://products.fourthwall.com"
    >
      Browse all
    </a>
  </div>
</section>

<style>
  .mobile-catalog-browse {
    display: none;
  }
  @media (max-width: 991px) {
    .mobile-catalog-browse {
      display: flex;
      position: relative;
      z-index: 0;
      justify-content: center;
      border-radius: var(--fw-radius-lg);
      padding: 12px 20px;
      margin-top: 48px;
      font-weight: 500;
    }
  }
</style>
