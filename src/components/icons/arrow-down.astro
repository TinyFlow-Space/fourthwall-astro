---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/utils";

const { className, ...props } = Astro.props;
---

<svg
  viewBox="0 0 12 8"
  aria-hidden="true"
  {...props}
  class={cn(
    "align-middle shrink-0 w-[.74em] h-[.5em] ml-[.35em] transition-transform duration-250 inline-block",
    className,
  )}
>
  <path
    d="M1.5 1.5 6 6l4.5-4.5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
