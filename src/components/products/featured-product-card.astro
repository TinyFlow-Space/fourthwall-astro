---
import { cn } from "@/utils";
import type { FeaturedProduct } from "@/data/products/featured-products";
import { Image } from "astro:assets";

interface Props {
  product: FeaturedProduct;
  index: number;
  classNames?: string;
}

const { product, index, classNames } = Astro.props;
---

<a
  rel="nofollow noopener"
  target="_blank"
  href={product.href}
  class={cn(
    "featured-card max-[992px]:aspect-5/6 max-[992px]:min-h-70 min-h-0 min-w-0 p-6 max-[992px]:p-3.5 bg-paper-soft flex flex-col justify-end no-underline text-inherit cursor-pointer max-w-full [grid-row-gap:12px] [transition:normal,normal_1.8s,1.8s_var(--ease-rise-in),var(--ease-rise-in)_opacity,transform]! scatter-reveal group",
    classNames,
  )}
  style={{ "--stagger-index": index }}
>
  <div class="ph-img-wrap relative flex items-center justify-center flex-1 min-h-0">
    <Image
      inferSize={true}
      src={product.src}
      loading="lazy"
      widths={[320, 480, 640, 800, 960, 1200]}
      sizes="(max-width: 991px) 50vw, 42vw"
      alt=""
      class="object-contain w-auto max-w-full 2md:h-auto min-h-full block hover-fade max-[992px]:absolute max-[992px]:inset-0 max-[992px]:size-full"
    />
    {product.hoverSrc && (
      <Image
        inferSize={true}
        src={product.hoverSrc}
        loading="lazy"
        widths={[320, 480, 640, 800, 960, 1200]}
        sizes="(max-width: 991px) 50vw, 42vw"
        alt=""
        class={cn(
          "absolute inset-0 pointer-events-none opacity-0 object-contain w-full max-w-full h-full min-h-full block hover-opacity group-hover:opacity-100!",
        )}
        aria-hidden="true"
      />
    )}
  </div>
  <div class="ph-rating inline-flex items-center self-start gap-x-1 rounded-full bg-background text-foreground text-xs leading-none font-medium mb-0 py-1 pr-2.5 pl-2 before:content-['★'] before:text-[0.95em] before:leading-none">
    {product.rating}
  </div>
  <h3 class="ph-title font-body 2md-[991px]:text-body-md max-2md:text-sm leading-[1.35] font-medium text-balance my-0 tracking-normal">
    {product.name}
  </h3>
</a>

<style>
  .featured-card:nth-child(4),
  .featured-card:nth-child(5) {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 0 !important;
  }
  .featured-card:nth-child(4) .ph-rating,
  .featured-card:nth-child(5) .ph-rating {
    z-index: 2;
    margin-left: 14px;
    position: relative;
  }
  .featured-card:nth-child(4) .ph-title,
  .featured-card:nth-child(5) .ph-title {
    z-index: 2;
    margin: 0px 14px 14px;
    color: var(--color-white);
    position: relative;
  }

  .featured-card:nth-child(4) .ph-img-wrap,
  .featured-card:nth-child(5) .ph-img-wrap {
    z-index: 0;
    position: absolute !important;
    inset: 0;
  }

  .featured-card:nth-child(4) img,
  .featured-card:nth-child(5) img {
    object-fit: cover !important;
    width: 100% !important;
    height: 100% !important;
  }
  .featured-card:nth-child(4)::after,
  .featured-card:nth-child(5)::after {
    z-index: 1;
    pointer-events: none;
    content: "";
    background-image: linear-gradient(#0000 0%, #0000004d 100%);
    height: 55%;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
  }

  @media (min-width: 992px) {
    .featured-card:nth-child(4)::before,
    .featured-card:nth-child(5)::before {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 170px;
      z-index: 1;
      pointer-events: none;
      -webkit-backdrop-filter: blur(3px);
      backdrop-filter: blur(3px);
      -webkit-mask-image: linear-gradient(to top, #000 40%, transparent 100%);
      mask-image: linear-gradient(to top, #000 40%, transparent 100%);
    }
    .featured-card:nth-child(4) .ph-rating,
    .featured-card:nth-child(5) .ph-rating {
      margin-left: 24px;
    }
    .featured-card:nth-child(4) .ph-title,
    .featured-card:nth-child(5) .ph-title {
      margin: 0px 24px 24px;
    }
  }
</style>
