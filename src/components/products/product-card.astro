      <span class="text-secondary-foreground text-xs leading-none whitespace-nowrap">
        +33
      </span>
    </div>
  </div>

  <!-- product info -->
  <p class="pr-4 text-foreground font-body text-body-md leading-relaxed font-normal my-0">
    Comfort Colors Garment-Dyed Heavyweight T-Shirt
  </p>
  <div class="flex items-center pr-4 gap-x-2 -mt-0.5 [&>p:not(:first-child)]:before:content-['|'] [&>p:not(:first-child)]:before:mr-[0.5em] [&>p:not(:first-child)]:before:opacity-40">
