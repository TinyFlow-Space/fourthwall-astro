---
import { Image } from "astro:assets";
import type { CATALOG_PRODUCTS } from "@/data/catalog-products";
interface Props {
  product: (typeof CATALOG_PRODUCTS)[number];
}
const { product } = Astro.props;
---

<a
  rel="noopener"
  target="_blank"
  href={product.href}
  class="catalog-card flex flex-col gap-y-2 no-underline relative max-w-full reveal group"
>
  <div class="catalog-media mb-1.5 aspect-3/4 bg-[#efeff0] block relative overflow-hidden">
    <Image
      src={product.src}
      inferSize
      widths={[200, 400, 640, 800]}
      sizes="(max-width: 991px) calc((100vw - 44px) / 2), (max-width: 1023px) 50vw, 25vw"
      alt={product.name}
      loading="lazy"
      class="object-cover size-full absolute inset-0"
    />
    <div class="catalog-badges absolute flex z-2 top-3 left-3 gap-x-1.5">
      {product.badges.map((badge) => (
        <span class="py-0.5 px-2 rounded-md bg-background text-foreground text-xs leading-snug font-medium whitespace-nowrap">
          {badge}
        </span>
      ))}
    </div>
    {product.colors.length > 0 && (
      <div
        class="catalog-colors absolute left-3 right-3 bottom-3 z-2 flex items-center gap-x-1"
        aria-label={`${product.colorCount} colors available`}
      >
        {product.colors.map((color) => (
          <span
            title={color.name}
            class="size-2.5 rounded-full border border-[#0a0a0a2e] shrink-0"
            style={{ background: color.hex }}
          />
        ))}
        {product.colorCount > 4 && (
          <span class="text-secondary-foreground text-xs leading-none">
            +{product.colorCount - 4}
          </span>
        )}
      </div>
    )}
  </div>
  <p class="pr-4 text-foreground font-body text-body-md leading-relaxed font-normal my-0">
    {product.name}
  </p>
  <div class="catalog-tech flex items-center pr-4 gap-x-2 -mt-0.5 text-secondary-foreground text-body-sm leading-normal">
    {product.tech.map((tech) => (
      <span>{tech}</span>
    ))}
  </div>
  <div
    class="flex items-center gap-x-2"
    aria-label={`Rated ${product.rating} out of 5, ${product.reviews} reviews`}
  >
    <span
      aria-hidden="true"
      class="catalog-stars"
      style={{ "--rating-fill": `${(product.rating / 5) * 100}%` }}
    >
      ★★★★★
    </span>
    <span class="text-[13px] text-secondary-foreground">{product.reviews}</span>
  </div>
  <p class="pr-4 text-secondary-foreground font-body text-body-sm leading-normal my-0">
    {product.price}
  </p>
</a>

<style>
  .catalog-tech > span + span::before {
    content: "|";
    opacity: 0.4;
    margin-right: 0.5em;
  }
  .catalog-stars {
    letter-spacing: 1px;
    background: linear-gradient(
      to right,
      #0a0a0a var(--rating-fill),
      #0a0a0a2e var(--rating-fill)
    );
    color: transparent;
    background-clip: text;
  }
  @media (max-width: 991px) {
    .catalog-badges {
      top: 12px;
      left: 12px;
      gap: 4px;
    }
    .catalog-badges span {
      font-size: 12px;
      padding: 2px 7px;
    }
    .catalog-tech {
      flex-wrap: wrap;
      gap: 4px;
    }
  }
  @media (max-width: 359px) {
    .catalog-badges {
      left: 6px;
      gap: 3px;
    }
    .catalog-badges span {
      font-size: 10px;
      padding-inline: 5px;
    }
  }
</style>

<style>
  @media (hover: hover) and (pointer: fine) {
    .catalog-colors {
      transition: gap 0.2s ease;
    }
    .catalog-colors span[title] {
      transition:
        width 0.2s ease,
        height 0.2s ease;
    }
    .catalog-card:hover .catalog-colors {
      gap: 6px;
    }
    .catalog-card:hover .catalog-colors span[title] {
      width: 18px;
      height: 18px;
    }
  }
</style>
