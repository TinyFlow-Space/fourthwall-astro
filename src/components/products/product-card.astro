---
import { cn } from "@/utils";
import { Image } from "astro:assets";
---

<a
  rel="noopener"
  target="_blank"
  href="https://products.fourthwall.com/comfort-colors-garment-dyed-heavyweight-t-shirt-dtg"
  class="flex flex-col gap-y-2 no-underline relative max-w-full reveal group"
>
  <!-- product media -->
  <div class="mb-1.5 aspect-3/4 bg-[#efeff0] block relative overflow-hidden">
    <Image
      inferSize
      widths={[320, 480, 640, 800, 1200]}
      sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
      alt="Comfort Colors Garment-Dyed Heavyweight T-Shirt"
      loading="lazy"
      src="https://cdn.fourthwall.com/product-catalog/pro_8be1acca2fe7403f89/ce527243-4847-4e46-a693-b5f1384d147c.jpeg"
      class="object-contain size-full absolute inset-0"
    />

    <!-- product badges -->
    <div class="absolute flex z-2 top-3 left-3 gap-x-1.5">
      <div class="py-0.5 px-2 rounded-md bg-background font-body text-foreground text-xs leading-snug font-medium whitespace-nowrap">
        <p class="my-0 text-inherit font-[inherit] [font-size:inherit] leading-[inherit] [font-weight:inherit]">
          Best seller
        </p>
      </div>
    </div>

    <!-- color switches -->
    <div class="absolute left-3 right-3 bottom-3 z-2 flex items-center gap-x-1 transition-[column-gap_.2s_ease]">
      <button
        type="button"
        class={cn(
          "size-2.5 cursor-pointer outline-offset-2 flex-[0_0_auto] p-0 border border-[#0a0a0a2e] rounded-full outline-transparent outline-1 outline-solid transition-[width_.2s_ease,height_.2s_ease,outline_color_.18s_ease] group-hover:size-4.5",
        )}
        title="Black"
        aria-label="Black"
        style="background: rgb(8, 8, 8);"
      ></button>
      <button
        type="button"
        class={cn(
          "size-2.5 cursor-pointer outline-offset-2 flex-[0_0_auto] p-0 border border-[#0a0a0a2e] rounded-full outline-transparent outline-1 outline-solid transition-[width_.2s_ease,height_.2s_ease,outline_color_.18s_ease] group-hover:size-4.5",
        )}
        title="True Navy"
        aria-label="True Navy"
        style="background: rgb(30, 43, 68);"
      ></button>
      <button
        type="button"
        class={cn(
          "size-2.5 cursor-pointer outline-offset-2 flex-[0_0_auto] p-0 border border-[#0a0a0a2e] rounded-full outline-transparent outline-1 outline-solid transition-[width_.2s_ease,height_.2s_ease,outline_color_.18s_ease] group-hover:size-4.5",
        )}
        title="Midnight"
        aria-label="Midnight"
        style="background: rgb(58, 78, 99);"
