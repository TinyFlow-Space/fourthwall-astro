---
import Accordion from "@/components/ui/accordion.astro";
import AccordionItem from "@/components/ui/accordion-item.astro";
import { FAQS } from "@/data";
---

<section class="py-surface-y-lg px-surface-x bg-background">
  <div class="container @container">
    <div class="max-w-[88ch] mb-[clamp(56px,2.8vw,80px)] mx-auto text-center reveal">
      <h2 class="text-heading-lg text-foreground leading-tight font-display font-medium tracking-[-.01em] my-0 p-0 normal-case">
        Frequently asked questions
      </h2>
    </div>

    <Accordion class="max-w-[clamp(800px,720px,1040px)] mx-auto reveal">
      {FAQS.map((faq) => (
        <AccordionItem title={faq.question}>
          {faq.answer.map((block) =>
            block.type === "paragraph" ? (
              <p class="not-last:mb-3.5 text-wrap nt">
                {block.content.map((part) =>
                  typeof part === "string" ? (
                    part
                  ) : "href" in part ? (
                    <a
                      href={part.href}
                      target="_blank"
                      rel="noreferrer"
                      class="underline"
                    >
                      {part.text}
                    </a>
                  ) : (
                    <strong>{part.text}</strong>
                  ),
                )}
              </p>
            ) : (
              <ul role="list" class="list-disc! pl-[1.25em] not-last:mb-3.5">
                {block.items.map((item) => (
                  <li class="mb-1">
                    {item.map((part) =>
                      typeof part === "string" ? (
                        part
                      ) : "href" in part ? (
                        <a
                          href={part.href}
                          target="_blank"
                          rel="noreferrer"
                          class="underline"
                        >
                          {part.text}
                        </a>
                      ) : (
                        <strong>{part.text}</strong>
                      ),
                    )}
                  </li>
                ))}
              </ul>
            ),
          )}
        </AccordionItem>
      ))}
    </Accordion>

    <div class="max-w-[clamp(800px,40vw,1040px)] mx-auto text-center mt-12 reveal">
      <p class="m-0 text-body-md leading-relaxed text-secondary-foreground">
        More questions?{" "}
        <a
          href="/faq"
          class="hover:text-foreground underline inline [transition:color_.2s_ease,text-decoration-color_.2s_ease]"
        >
          Browse all FAQs
        </a>{" "}
        or{" "}
        <a
          href="https://help.fourthwall.com"
          target="_blank"
          rel="noopener"
          class="hover:text-foreground underline inline [transition:color_.2s_ease,text-decoration-color_.2s_ease]"
        >
          visit the help center
        </a>
        .
      </p>
    </div>
  </div>
</section>
