---
import { cn } from "@/utils";
import { HERO_SLIDERS } from "@/data";
import CarouselNavButton from "@/components/ui/carousel-nav-button.astro";
---

<div
  data-hero-slider
  class="z-3 px-surface-x relative pb-0 pt-[clamp(24px,1.2vw,48px)]"
>
  <div
    data-hero-track
    class="flex gap-4 snap-x snap-mandatory scroll-pl-[max(40px,50vw-940px)] overflow-x-auto overflow-y-hidden px-[max(40px,50vw-940px)] -mx-[max(40px,900px-940px)] scrollbar-none [&::-webkit-scrollbar]:hidden"
  >
    <!-- slider card -->
    {HERO_SLIDERS.map((item, index) => (
      <div
        data-carousel-item
        class="hero-track-item flex m-0 flex-none flex-col snap-start scatter-reveal scatter-reveal-active cursor-none"
        style={{
          "--stagger-index": index,
          "--rise-distance": "56px",
        }}
        data-cursor-label={item.title}
      >
        <a
          rel="nofollow"
          href={item.url}
          target="_blank"
          aria-label={item.title}
          class={cn(
            "aspect-1120/1240 bg-paper-soft overflow-hidden block flex-none max-w-full min-w-0 no-underline w-[calc(clamp(320px,35vw,960px)/1.10714)] h-[clamp(320px,35vw,960px)] cursor-none!",
            item.type === "video" &&
              "aspect-6/5 w-[calc(1.2*clamp(320px,35vw,960px))]",
          )}
        >
          {item.type === "video" ? (
            <video
              muted
              loop
              playsinline
              autoplay
              preload="auto"
              poster={item.poster}
              class="object-cover size-full block"
            >
              <source src={item.src} type="video/webm" />
            </video>
          ) : (
            <img
              src={item.src}
              loading="eager"
              fetchpriority="high"
              alt={item.title}
              class="object-cover size-full block"
            />
          )}
        </a>
      </div>
    ))}
  </div>

  <!--  NEXT/PREV buttons -->
  <div class="scatter-reveal scatter-reveal-active flex gap-3 absolute -top-19 right-10 z-3">
    <CarouselNavButton
      data-carousel-prev
      aria-label="Previous"
      variant="default"
      disabled={true}
      class="text-white"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        class="block h-7.5 w-7.5 -translate-px"
      >
        <path
          d="M15 6l-6 6 6 6"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </CarouselNavButton>

    <CarouselNavButton
      data-carousel-next
      aria-label="Next"
      variant="default"
      disabled={false}
      class="text-white"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        class="block h-7.5 w-7.5 translate-px"
      >
        <path
          d="M9 6l6 6-6 6"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </CarouselNavButton>
  </div>

  <!-- custom cursor tracking -->
  <div
    data-hero-cursor
    aria-hidden="true"
    class="fixed top-0 left-0 z-30 pointer-events-none invisible opacity-0 whitespace-nowrap bg-white text-foreground rounded-full px-4 py-1.5 text-body-md font-medium"
  ></div>
</div>

<script>
  import gsap from "gsap";

  const root = document.querySelector("[data-hero-slider]");

  if (root) {
    const track = root.querySelector<HTMLElement>("[data-hero-track]");
    const prevButton = root.querySelector<HTMLButtonElement>(
      "[data-carousel-prev]",
    );
    const nextButton = root.querySelector<HTMLButtonElement>(
      "[data-carousel-next]",
    );

    if (track && prevButton && nextButton) {
      const getGap = () => {
        const styles = window.getComputedStyle(track);
        return Number.parseFloat(styles.gap || "0") || 0;
      };

      const getStepSize = () => {
        const firstItem = track.querySelector<HTMLElement>(
          "[data-carousel-item]",
        );

        if (!firstItem) return 0;

        return firstItem.getBoundingClientRect().width + getGap();
      };

      const updateButtonState = (
        button: HTMLButtonElement,
        disabled: boolean,
      ) => {
        button.disabled = disabled;
        button.setAttribute("aria-disabled", String(disabled));
        button.classList.toggle("opacity-30", disabled);
        button.classList.toggle("pointer-events-none", disabled);
      };

      const updateStates = () => {
        const maxScrollLeft = Math.max(
          track.scrollWidth - track.clientWidth,
          0,
        );
        const atStart = track.scrollLeft <= 1;
        const atEnd = track.scrollLeft >= maxScrollLeft - 1;

        updateButtonState(prevButton, atStart);
        updateButtonState(nextButton, atEnd);
      };

      const scrollByOneItem = (direction: number) => {
        const stepSize = getStepSize();

        if (!stepSize) return;

        track.scrollBy({ left: direction * stepSize, behavior: "smooth" });
        requestAnimationFrame(updateStates);
      };

      prevButton.addEventListener("click", () => {
        if (prevButton.disabled) return;
        scrollByOneItem(-1);
      });

      nextButton.addEventListener("click", () => {
        if (nextButton.disabled) return;
        scrollByOneItem(1);
      });

      track.addEventListener(
        "scroll",
        () => {
          requestAnimationFrame(updateStates);
        },
        { passive: true },
      );

      if ("ResizeObserver" in window) {
        const observer = new ResizeObserver(() => {
          requestAnimationFrame(updateStates);
        });

        observer.observe(track);
      }

      updateStates();
    }
  }

  // cursor tracking
  const cursor = document.querySelector<HTMLElement>("[data-hero-cursor]");
  const canHover = window.matchMedia(
    "(hover: hover) and (pointer: fine)",
  ).matches;

  if (cursor && canHover) {
    document.body.appendChild(cursor);

    gsap.set(cursor, { xPercent: -50, yPercent: -50, autoAlpha: 0 });

    const setX = gsap.quickTo(cursor, "x", { duration: 0.4, ease: "power3" });
    const setY = gsap.quickTo(cursor, "y", { duration: 0.4, ease: "power3" });

    let isActive = false;

    const follow = (e: MouseEvent) => {
      setX(e.clientX);
      setY(e.clientY);
    };

    const show = (e: MouseEvent, label: string) => {
      cursor.textContent = label;

      if (!isActive) {
        isActive = true;
        // jump to the pointer on first enter (2nd arg = start value), no glide from 0,0
        setX(e.clientX, e.clientX);
        setY(e.clientY, e.clientY);
        document.addEventListener("mousemove", follow);
      } else {
        follow(e);
      }

      gsap.to(cursor, {
        autoAlpha: 1,
        duration: 0.15,
        ease: "none",
        overwrite: "auto",
      });
    };

    const hide = () => {
      isActive = false;
      document.removeEventListener("mousemove", follow);
      gsap.to(cursor, {
        autoAlpha: 0,
        duration: 0.15,
        ease: "none",
        overwrite: "auto",
      });
    };

    document.querySelectorAll<HTMLElement>(".hero-track-item").forEach((el) => {
      el.addEventListener("mouseenter", (e) =>
        show(e, el.dataset.cursorLabel ?? ""),
      );
      el.addEventListener("mouseleave", hide);
    });
  }
</script>
