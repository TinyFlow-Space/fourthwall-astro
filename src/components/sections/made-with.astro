        </div>
      </div>
    </div>

    <div
      data-made-wall-cursor
      aria-hidden="true"
      class="fixed top-0 left-0 z-30 pointer-events-none invisible opacity-0 whitespace-nowrap bg-white text-foreground rounded-full px-4 py-1.5 text-body-md font-medium"
    ></div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { initCursorTracking } from "@/lib/cursor-tracking";

  gsap.registerPlugin(ScrollTrigger);

  const cleanups = new WeakMap<HTMLElement, () => void>();

  const initializeMadeWall = () => {
    const section = document.querySelector<HTMLElement>(
      "[data-made-wall-section]",
    );
    if (!section || cleanups.has(section)) return;

    const stage = section.querySelector<HTMLElement>("[data-made-wall-stage]");
    const wall = section.querySelector<HTMLElement>("[data-made-wall-items]");
    const cursor = section.querySelector<HTMLElement>(
      "[data-made-wall-cursor]",
    );
    const items = Array.from(
      wall?.querySelectorAll<HTMLElement>(".made-wall-item") ?? [],
    );

    if (!stage || !wall || !cursor || !items.length) return;

    let frameId = 0;
    let isVisible = false;
    let lastFrameTime = 0;
    let radius = 0;
    let itemWidth = 0;
    let itemHeight = 0;
    let angleOffset = 0;
    let dragVelocity = 0;
    let pointerId: number | null = null;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let previousPointerX = 0;
    let previousPointerY = 0;
    let previousPointerTime = 0;
    let gestureAxis: "horizontal" | "vertical" | null = null;
    let didDrag = false;
    let suppressClickUntil = 0;
    const autoSpeed = 0.5;
    const dragSensitivity = 0.15;
    const firstAngle = 44.17;
    const angleStep = 15;

    const setProgress = (value: number) => {
      const progress = Math.min(1, Math.max(0, value)).toFixed(4);
      if (section.style.getPropertyValue("--expand-progress") !== progress) {
        section.style.setProperty("--expand-progress", progress);
      }
    };

    const resize = () => {
      itemWidth = Math.min(489.6, Math.max(180, window.innerWidth * 0.34));
      itemHeight = itemWidth * (309.6 / 489.6);
      radius = itemWidth * 4.137;

      items.forEach((item) => {
        item.style.setProperty("--w", `${itemWidth.toFixed(1)}px`);
        item.style.setProperty("--h", `${itemHeight.toFixed(1)}px`);
      });

      updateItems();
    };

    const updateItems = () => {
      const normalizedOffset = ((angleOffset % 360) + 360) % 360;

      items.forEach((item, index) => {
        const column = index % 24;
        const row = Math.floor(index / 24);
        const angle = firstAngle + column * angleStep + normalizedOffset;
        const radians = (angle * Math.PI) / 180;
        const x = Math.sin(radians) * radius;
        const z = (Math.cos(radians) - 1) * radius;
        const y =
          (row === 0 ? (index === 0 ? -29.1 : -291.2) : (row - 1) * 291.2) *
          (itemHeight / 309.6);
        const visibleAngle = ((angle % 360) + 360) % 360;
        const rotation = ((((angle + 180) % 360) + 360) % 360) - 180;
        const visible = visibleAngle <= 60 || visibleAngle >= 300;

        item.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, ${z.toFixed(1)}px) rotateY(${rotation.toFixed(2)}deg)`;
        const visibility = visible ? "visible" : "hidden";
        if (item.style.visibility !== visibility) {
          item.style.visibility = visibility;
        }
      });
    };

    const animate = (time: number) => {
      if (!isVisible || document.visibilityState === "hidden") {
        frameId = 0;
        lastFrameTime = 0;
        return;
      }

      const delta = lastFrameTime
        ? Math.min((time - lastFrameTime) / 1000, 0.05)
        : 0;
      lastFrameTime = time;

      if (pointerId === null) {
        angleOffset += (autoSpeed + dragVelocity) * delta;
        dragVelocity *= Math.exp(-4 * delta);
      }

      updateItems();
      frameId = window.requestAnimationFrame(animate);
    };

    const startAnimation = () => {
      if (!isVisible || frameId || document.visibilityState === "hidden")
        return;
      frameId = window.requestAnimationFrame(animate);
    };

    const onPointerDown = (event: PointerEvent) => {
      if (
        !event.isPrimary ||
        (event.pointerType === "mouse" && event.button !== 0)
      ) {
        return;
      }

      pointerId = event.pointerId;
      pointerStartX = previousPointerX = event.clientX;
      pointerStartY = previousPointerY = event.clientY;
      previousPointerTime = performance.now();
      gestureAxis = null;
      didDrag = false;
      dragVelocity = 0;
    };

    const onPointerMove = (event: PointerEvent) => {
      if (pointerId !== event.pointerId) return;

      const deltaX = event.clientX - previousPointerX;
      const deltaY = event.clientY - previousPointerY;
      const now = performance.now();
      const elapsed = Math.max((now - previousPointerTime) / 1000, 0.008);

      if (!gestureAxis) {
        const totalX = event.clientX - pointerStartX;
        const totalY = event.clientY - pointerStartY;
        if (Math.hypot(totalX, totalY) > 6) {
          gestureAxis =
            Math.abs(totalX) > Math.abs(totalY) ? "horizontal" : "vertical";
        }
      }

      if (gestureAxis === "horizontal" && !didDrag) {
        didDrag = true;
        section.classList.add("is-dragging", "cursor-grabbing");
        stage.setPointerCapture(event.pointerId);
      }

      if (didDrag) {
        if (event.cancelable) event.preventDefault();
        angleOffset += deltaX * dragSensitivity;
        dragVelocity = Math.max(
          -120,
          Math.min(120, (deltaX / elapsed) * dragSensitivity - autoSpeed),
        );
        updateItems();
      }

      previousPointerX = event.clientX;
      previousPointerY = event.clientY;
      previousPointerTime = now;
    };

    const finishPointer = (event: PointerEvent) => {
      if (pointerId !== event.pointerId) return;

      pointerId = null;
      gestureAxis = null;
      section.classList.remove("is-dragging", "cursor-grabbing");
      if (didDrag) suppressClickUntil = performance.now() + 350;
      didDrag = false;
    };

    const onClick = (event: MouseEvent) => {
      if (performance.now() >= suppressClickUntil) return;
      event.preventDefault();
      event.stopPropagation();
    };

    const onVisibilityChange = () => {
      if (document.visibilityState === "hidden" && frameId) {
        window.cancelAnimationFrame(frameId);
        frameId = 0;
        lastFrameTime = 0;
      } else {
        startAnimation();
      }
    };

    resize();
    window.addEventListener("resize", resize, { passive: true });

    const scrollTrigger = ScrollTrigger.create({
      trigger: stage,
      start: "top bottom",
      end: () =>
        `+=${Math.min(stage.clientHeight * 0.8, document.documentElement.clientHeight)}`,
      scrub: true,
      invalidateOnRefresh: true,
      onUpdate: (self) => setProgress(self.progress),
      onRefresh: (self) => setProgress(self.progress),
    });

    const visibilityObserver = new IntersectionObserver(
      ([entry]) => {
        isVisible = entry.isIntersecting;
        if (isVisible) startAnimation();
        else if (frameId) {
          window.cancelAnimationFrame(frameId);
          frameId = 0;
          lastFrameTime = 0;
        }
      },
      { threshold: 0 },
    );
    visibilityObserver.observe(stage);

    stage.addEventListener("pointerdown", onPointerDown, true);
    window.addEventListener("pointermove", onPointerMove, { passive: false });
    window.addEventListener("pointerup", finishPointer);
    window.addEventListener("pointercancel", finishPointer);
    stage.addEventListener("lostpointercapture", finishPointer);
    stage.addEventListener("click", onClick, true);
    document.addEventListener("visibilitychange", onVisibilityChange);

    const cursorCleanup = initCursorTracking(
      section,
      ".made-wall-item",
      cursor,
      "data-name",
    );

    const cleanup = () => {
      if (frameId) window.cancelAnimationFrame(frameId);
      section.classList.remove("is-dragging", "cursor-grabbing");
      stage.removeEventListener("pointerdown", onPointerDown, true);
      window.removeEventListener("pointermove", onPointerMove);
      window.removeEventListener("pointerup", finishPointer);
      window.removeEventListener("pointercancel", finishPointer);
      stage.removeEventListener("lostpointercapture", finishPointer);
      stage.removeEventListener("click", onClick, true);
      window.removeEventListener("resize", resize);
      document.removeEventListener("visibilitychange", onVisibilityChange);
      if (pointerId !== null && stage.hasPointerCapture(pointerId)) {
        stage.releasePointerCapture(pointerId);
      }
      visibilityObserver.disconnect();
      scrollTrigger.kill();
      cursorCleanup();
    };

    cleanups.set(section, cleanup);
  };

  const disposeMadeWall = () => {
    const section = document.querySelector<HTMLElement>(
      "[data-made-wall-section]",
    );
    const cleanup = section && cleanups.get(section);
    if (!section || !cleanup) return;
    cleanup();
    cleanups.delete(section);
  };

  document.addEventListener("astro:page-load", initializeMadeWall);
  document.addEventListener("astro:before-swap", disposeMadeWall);
  initializeMadeWall();
</script>
