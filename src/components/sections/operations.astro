              </div>
            </div>
          </div>
        </div>

        <p class="max-w-none pt-6 font-display text-foreground text-body-lg leading-normal font-medium tracking-normal text-balance m-0">
          Apps and integrations you'll love.
          <span class="text-secondary-foreground">
            {" "}
            We integrate with YouTube, Instagram, TikTok, Spotify, and more.
            Plus live gifting, on-screen notifications, and chat-driven
            purchases for your audience.
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const transitionDuration = 900;
  const tileStagger = 120;
  const cycleDelay = 2000;
  const iconDuration = 500;
  const instances = new WeakMap<HTMLElement, () => void>();

  const initializeAnimations = () => {
    document
      .querySelectorAll<HTMLElement>("[data-ai-animation]")
      .forEach((animation) => {
        if (instances.has(animation)) return;

        const slides = Array.from(
          animation.querySelectorAll<HTMLElement>("[data-ai-slide]"),
        );
        const labels = Array.from(
          animation.querySelectorAll<HTMLElement>("[data-ai-label]"),
        );
        const icon = animation.querySelector<SVGElement>("[data-ai-icon]");

        if (!slides.length || slides.length !== labels.length || !icon) {
          console.error(
            "Operations AI slides, labels, and icon must be present.",
          );
          return;
        }

        const motionPreference = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );
        const tileCount = slides[0].querySelectorAll(".ai-tile").length;
        const transitionSpan =
          transitionDuration + tileStagger * Math.max(tileCount - 1, 0);
        let currentIndex = 0;
        let timer: number | undefined;
        let iconAnimation: Animation | null = null;

        const setState = (
          index: number,
          state: "is-active" | "is-existing" | null,
        ) => {
          const slide = slides[index];
          const label = labels[index];
          const tiles = slide
            ? Array.from(slide.querySelectorAll<HTMLElement>(".ai-tile"))
            : [];

          const active = state === "is-active";
          const existing = state === "is-existing";

          [slide, ...tiles, label].forEach((element) => {
            if (!element) return;
            element.classList.toggle("is-active", active);
            element.classList.toggle("is-existing", existing);
          });

          if (slide) {
            slide.setAttribute("aria-hidden", String(!active));
          }
          if (label) {
            label.setAttribute("aria-hidden", String(!active));
          }
        };

        const stopIconAnimation = () => {
          if (iconAnimation) {
            iconAnimation.cancel();
            iconAnimation = null;
          }
        };

        const reset = () => {
          if (timer !== undefined) {
            window.clearTimeout(timer);
            timer = undefined;
          }
          stopIconAnimation();
          slides.forEach((_, index) => {
            setState(index, index === 0 ? "is-active" : null);
          });
          currentIndex = 0;
        };

        const advance = () => {
          if (motionPreference.matches) return;

          const previousIndex = currentIndex;
          const nextIndex = (currentIndex + 1) % slides.length;

          setState(previousIndex, "is-existing");
          setState(nextIndex, "is-active");

          stopIconAnimation();
          iconAnimation = icon.animate(
            [{ transform: "rotate(0deg)" }, { transform: "rotate(360deg)" }],
            {
              duration: iconDuration,
              easing: "cubic-bezier(0.34, 1.56, 0.64, 1)",
              fill: "forwards",
            },
          );

          currentIndex = nextIndex;
          timer = window.setTimeout(() => {
            setState(previousIndex, null);
            timer = window.setTimeout(advance, cycleDelay);
          }, transitionSpan);
        };

        const handleMotionPreferenceChange = () => {
          reset();
          if (!motionPreference.matches) {
            timer = window.setTimeout(advance, cycleDelay);
          }
        };

        reset();
        if (!motionPreference.matches) {
          timer = window.setTimeout(advance, cycleDelay);
        }

        motionPreference.addEventListener(
          "change",
          handleMotionPreferenceChange,
        );

        instances.set(animation, () => {
          if (timer !== undefined) {
            window.clearTimeout(timer);
            timer = undefined;
          }
          stopIconAnimation();
          reset();
          motionPreference.removeEventListener(
            "change",
            handleMotionPreferenceChange,
          );
        });
      });
  };

  const disposeAnimations = () => {
    document
      .querySelectorAll<HTMLElement>("[data-ai-animation]")
      .forEach((animation) => {
        const cleanup = instances.get(animation);
        if (cleanup) {
          cleanup();
          instances.delete(animation);
        }
      });
  };

  document.addEventListener("astro:page-load", initializeAnimations);
  document.addEventListener("astro:before-swap", disposeAnimations);
  initializeAnimations();
</script>

<style>
  [data-ai-animation] .ai-slide {
    z-index: 0;
  }

  [data-ai-animation] .ai-slide.is-active {
    z-index: 2;
  }

  [data-ai-animation] .ai-slide.is-existing {
    z-index: 1;
  }

  [data-ai-animation] .ai-tile {
    opacity: 1;
    transform: translateY(100%);
    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--tile-delay, 0s);
  }

  [data-ai-animation] .ai-tile:nth-child(1) {
    --tile-delay: 0s;
  }

  [data-ai-animation] .ai-tile:nth-child(2) {
    --tile-delay: 0.12s;
  }

  [data-ai-animation] .ai-tile:nth-child(3) {
    --tile-delay: 0.24s;
  }

  [data-ai-animation] .ai-tile.is-active,
  [data-ai-animation] .ai-label.is-active {
    transform: translateY(0);
  }

  [data-ai-animation] .ai-tile.is-existing,
  [data-ai-animation] .ai-label.is-existing {
    transform: translateY(-100%);
  }

  [data-ai-animation] .ai-label {
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 0.5s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.5s;
  }

  [data-ai-animation] .ai-label.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  [data-ai-animation] .ai-label.is-existing {
    opacity: 0;
    transform: translateY(-100%);
  }

  [data-ai-animation] [data-ai-icon] {
    transform-origin: center;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ai-animation] .ai-tile,
    [data-ai-animation] .ai-label,
    [data-ai-animation] [data-ai-icon] {
      transition: none;
    }
  }
</style>
