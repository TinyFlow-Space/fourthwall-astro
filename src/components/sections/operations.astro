---
import { Image } from "astro:assets";
import { OPERATIONS_AI_DATA } from "@/data";
---

<section
  data-scatter-reveal-section
  class="px-surface-x pt-surface-y-sm pb-surface-y-lg bg-background"
>
  <div class="container @container">
    <div class="mb-10 max-w-[88ch] reveal">
      <h2 class="font-display text-foreground text-heading-lg leading-tight font-medium normal-case my-0 p-0">
        The whole operation.
        <span class="text-secondary-foreground"> One dashboard.</span>
      </h2>
    </div>

    <!-- operations  -->
    <div class="grid grid-cols-2 gap-x-[clamp(32px,1.6vw,56px)] gap-y-[clamp(64px,3.2vw,96px)]">
      <!-- operation ai  -->
      <div
        class="min-h-0 p-0 col-span-full flex flex-col relative overflow-hidden scatter-reveal"
        style={{ "--stagger-index": 0 }}
      >
        <!-- ai box -->
        <div
          data-ai-animation
          class="aspect-40/13 w-full relative overflow-hidden @container"
        >
          {OPERATIONS_AI_DATA.map((item, index) => (
            <div
              data-ai-slide
              aria-hidden={index === 0 ? "false" : "true"}
              class:list={[
                "ai-slide absolute inset-0 grid grid-cols-3 pointer-events-none",
                index === 0 && "is-active",
              ]}
            >
              {item.images.map((img) => (
                <div
                  class:list={[
                    "ai-tile flex items-center justify-center bg-[#efeff0]",
                    index === 0 && "is-active",
                  ]}
                >
                  <Image
                    src={img.src}
                    loading="lazy"
                    fetchpriority="high"
                    inferSize={true}
                    format="webp"
                    alt={img.alt}
                    class="object-cover size-full block"
                  />
                </div>
              ))}
            </div>
          ))}

          <!-- title overlap -->
          <div
            aria-hidden="true"
            tabindex="-1"
            class="max-w-full contents pointer-events-none text-inherit cursor-auto"
          >
            <div class="absolute top-1/2 left-1/2 z-2 inline-flex min-w-[46cqi] -translate-x-1/2 -translate-y-1/2 cursor-text items-center justify-start gap-x-[1cqi] whitespace-nowrap rounded-[1.4cqi] bg-[#3c3c3c66] px-[1.8cqi] py-[1.5cqi] font-display text-[1.7cqi] font-medium tracking-[-.01em] text-white backdrop-blur-lg backdrop-saturate-[1.8]">
              <svg
                data-ai-icon
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="shrink-0 size-[1.9cqi]"
              >
                <path
                  d="M11.2003 0.575117C11.4577 -0.191706 12.5423 -0.191706 12.7997 0.575117C14.4817 5.58555 18.4144 9.51827 23.4249 11.2003C24.1917 11.4577 24.1917 12.5423 23.4249 12.7997C18.4144 14.4817 14.4817 18.4144 12.7997 23.4249C12.5423 24.1917 11.4577 24.1917 11.2003 23.4249C9.51827 18.4144 5.58555 14.4817 0.575117 12.7997C-0.191706 12.5423 -0.191706 11.4577 0.575117 11.2003C5.58555 9.51827 9.51827 5.58555 11.2003 0.575117Z"
                  fill="currentColor"
                ></path>
              </svg>
              <span class="relative grid h-[1.25em] flex-1 grid-cols-1 overflow-hidden leading-[125%]">
                {OPERATIONS_AI_DATA.map((item, index) => (
                  <span
                    data-ai-label
                    aria-hidden={index === 0 ? "false" : "true"}
                    class:list={[
                      "ai-label col-start-1 row-start-1 text-center",
                      index === 0 && "is-active",
                    ]}
                  >
                    {item.title}
                  </span>
                ))}
              </span>
            </div>
          </div>
        </div>

        <!-- bottom content -->
        <p class="max-w-none pt-6 font-display text-foreground text-body-lg leading-normal font-medium tracking-normal text-balance m-0">
          Expert, personalized advice from your own AI assistant.
          <span class="text-secondary-foreground">
            {" "}
            Our team has helped creators sell billions of dollars of products.
            We put everything we've learned into Eli, an AI assistant who can
            help you achieve your goals.
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const transitionDuration = 500;
  const tileStagger = 120;
  const cyclePause = 2000;
  const instances = new Map<HTMLElement, () => void>();

  const initializeAnimations = () => {
    document
      .querySelectorAll<HTMLElement>("[data-ai-animation]")
      .forEach((animation) => {
        if (instances.has(animation)) return;

        const slides = Array.from(
          animation.querySelectorAll<HTMLElement>("[data-ai-slide]"),
        );
        const labels = Array.from(
          animation.querySelectorAll<HTMLElement>("[data-ai-label]"),
        );
        const icon = animation.querySelector<SVGElement>("[data-ai-icon]");
        const tiles = slides.map((slide) =>
          Array.from(slide.querySelectorAll<HTMLElement>(".ai-tile")),
        );

        if (!slides.length || slides.length !== labels.length || !icon) {
          console.error(
            "Operations AI slides, labels, and icon must be present.",
          );
          return;
        }

        const motionPreference = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );
        const transitionSpan =
          transitionDuration + tileStagger * (tiles[0].length - 1);
        let currentIndex = 0;
        let timer: number | undefined;
        let iconAnimation: Animation | undefined;

        const setState = (
          index: number,
          state: "is-active" | "is-existing" | null,
        ) => {
          const active = state === "is-active";
          [slides[index], ...tiles[index], labels[index]].forEach((element) => {
            element.classList.toggle("is-active", active);
            element.classList.toggle("is-existing", state === "is-existing");
          });
          slides[index].setAttribute("aria-hidden", String(!active));
          labels[index].setAttribute("aria-hidden", String(!active));
        };

        const reset = () => {
          if (timer !== undefined) window.clearTimeout(timer);
          timer = undefined;
          iconAnimation?.cancel();
          iconAnimation = undefined;
          slides.forEach((_, index) => {
            setState(index, index === 0 ? "is-active" : null);
          });
          currentIndex = 0;
        };

        const advance = () => {
          if (motionPreference.matches) return;

          const nextIndex = (currentIndex + 1) % slides.length;
          const previousIndex =
            (currentIndex - 1 + slides.length) % slides.length;

          setState(previousIndex, null);
          setState(currentIndex, "is-existing");
          setState(nextIndex, "is-active");

          iconAnimation?.cancel();
          iconAnimation = icon.animate(
            [{ rotate: "0deg" }, { rotate: "360deg" }],
            {
              duration: transitionDuration,
              easing: "cubic-bezier(.34,1.56,.64,1)",
            },
          );

          currentIndex = nextIndex;
          timer = window.setTimeout(() => {
            setState(previousIndex, null);
            timer = window.setTimeout(advance, cyclePause);
          }, transitionSpan);
        };

        const handleMotionPreferenceChange = () => {
          reset();
          if (!motionPreference.matches) {
            timer = window.setTimeout(advance, cyclePause);
          }
        };

        reset();
        if (!motionPreference.matches) {
          timer = window.setTimeout(advance, cyclePause);
        }

        motionPreference.addEventListener(
          "change",
          handleMotionPreferenceChange,
        );

        instances.set(animation, () => {
          reset();
          motionPreference.removeEventListener(
            "change",
            handleMotionPreferenceChange,
          );
        });
      });
  };

  const disposeAnimations = () => {
    instances.forEach((cleanup) => cleanup());
    instances.clear();
  };

  document.addEventListener("astro:page-load", initializeAnimations);
  document.addEventListener("astro:before-swap", disposeAnimations);
  initializeAnimations();
</script>

<style>
  [data-ai-animation] .ai-tile {
    transform: translateY(100%);
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  [data-ai-animation] .ai-tile:nth-child(1) {
    transition-delay: 0s;
  }

  [data-ai-animation] .ai-tile:nth-child(2) {
    transition-delay: 0.12s;
  }

  [data-ai-animation] .ai-tile:nth-child(3) {
    transition-delay: 0.24s;
  }

  [data-ai-animation] .ai-tile.is-active,
  [data-ai-animation] .ai-label.is-active {
    transform: translateY(0);
  }

  [data-ai-animation] .ai-tile.is-existing,
  [data-ai-animation] .ai-label.is-existing {
    transform: translateY(-100%);
  }

  [data-ai-animation] .ai-label {
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 0.5s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  [data-ai-animation] .ai-label.is-active {
    opacity: 1;
    z-index: 2;
  }

  [data-ai-animation] [data-ai-icon] {
    transition: rotate 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: center;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ai-animation] .ai-tile,
    [data-ai-animation] .ai-label,
    [data-ai-animation] [data-ai-icon] {
      transition: none;
    }
  }

  [data-ai-animation] .ai-slide.is-active {
    z-index: 2;
  }

  [data-ai-animation] .ai-slide.is-existing {
    z-index: 1;
  }

  [data-ai-animation] .ai-label.is-existing {
    z-index: 1;
  }
</style>
