              </div>
            </div>

            <!-- init row left 2 -->
            <div class="flex h-[14.5cqi] items-center overflow-hidden">
              <div class="flex w-max shrink-0 gap-x-[1.5cqi] will-change-transform animate-scroll-x-left [--scroll-duration:60s]">
                <AiIntegrationBox />
