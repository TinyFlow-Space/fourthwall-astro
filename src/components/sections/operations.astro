          </span>
        </p>
      </div>

      <!-- operations integrations -->
      <div
        class="min-h-0 p-0 flex flex-col relative overflow-hidden scatter-reveal"
        style={{ "--stagger-index": 1 }}
      >
        <!-- integrations box -->
        <div class="aspect-3/2 bg-[#efeff0] w-full relative overflow-hidden @container">
          <!-- init track -->
          <div class="absolute inset-0 flex flex-col justify-center gap-y-[1.5cqi]">
