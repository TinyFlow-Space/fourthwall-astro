---
import { FOOTER_BOTTOM_LINKS } from "@/data";
import { cn } from "@/utils";
---

<section
  data-wordmark-section
  class="wordmark-section pt-20 pb-10 px-surface-x bg-surface-dark text-white -mt-px overflow-hidden block shadow-[0_-4px_0_var(--surface-dark)]"
>
  <div class="footer-wordmark-wrap w-full block opacity-0 transform-[translate3d(0,120px,0)] reveal-transition">
    <div class="perspective-distant w-full block">
      <svg
        class="logo block w-full h-auto text-white transform-3d origin-[center_top] transform-[rotateX(0deg)_rotateY(0deg)] transition-[transform_.25s_var(--ease-rise-in)]"
        viewBox="0 0 113 20"
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M11.8496 0.0162964H9.54486L9.55883 0C5.65475 0 3.9716 0.70539 3.27319 4.13921L3.05901 5.07042H1.08253L0.407403 8.23652H2.4095L0 19.6438H4.46513L6.8723 8.23652H9.09836C7.95179 9.93564 7.44963 11.969 7.44963 13.6794C7.44963 17.9537 10.4341 19.9837 14.3312 19.9837C18.2096 19.9837 20.5851 17.9409 21.8244 15.4998C21.8206 15.5875 21.8178 15.6752 21.8158 15.763C21.8158 18.6311 23.3547 19.9837 26.0063 19.9837V20C28.4949 20 29.9988 18.9454 30.93 17.7814L30.525 19.6438H34.8807L37.9723 5.08673H33.5071L31.8775 12.718C31.3351 15.316 30.064 16.6127 28.2784 16.6127C27.0353 16.6127 26.4393 15.898 26.4393 14.5175C26.4526 13.9065 26.5346 13.299 26.6837 12.7063L28.3133 5.07509H23.8482L22.8367 9.89471C22.3662 6.37532 19.6057 4.69796 16.0633 4.69796C13.6185 4.69796 11.7663 5.50688 10.418 6.71493L10.7694 5.07508H7.54976L7.68478 4.34641C7.95483 3.23594 8.30636 3.15446 9.90338 3.15446H11.1745L11.8496 0.0162964ZM15.7374 8.16205C13.3023 8.16205 12.0568 10.6763 12.0568 13.4629C12.0568 15.493 12.9507 16.5196 14.6176 16.5196C17.0527 16.5196 18.2982 14.0054 18.2982 11.2164C18.2982 9.1887 17.4042 8.16205 15.7374 8.16205Z"
        ></path>
        <path d="M102.552 0.0186232H107.015V19.6322H102.552V0.0186232Z"></path>
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M94.5249 7.64752C93.0909 7.64752 92.0898 8.37619 91.9269 9.78464H87.8616L85.5922 19.6322H80.3961L78.4499 8.89071L76.5013 19.6322H71.3354L67.9808 5.07509H72.553L74.4736 14.9505L76.1498 5.07509H80.7499L82.454 14.9505L84.3747 5.07509H88.9469L88.285 7.94714C89.2779 6.04767 91.6056 4.61644 94.9021 4.61644C99.0692 4.61644 101.479 6.29262 101.395 10.7321L101.341 13.8959C101.316 15.7909 101.395 18.3867 101.665 19.6321H97.2836L97.2301 17.8722C96.1476 19.4156 94.4155 19.9837 92.3413 19.9837C89.5826 19.9837 87.3104 18.3541 87.3104 15.7094C87.3104 12.1383 91.3425 10.9463 96.995 10.5412V9.97321C96.995 8.2691 96.1289 7.64519 94.5342 7.64519L94.5249 7.64752ZM93.9662 16.9573C95.7495 16.9573 97.1044 16.2007 97.1044 13.5234V13.1649C93.9918 13.435 91.9082 13.8424 91.9082 15.3835C91.9082 16.331 92.8022 16.9526 93.9662 16.9526V16.9573Z"
        ></path>
        <path d="M112.69 0.0186232H108.225V19.6322H112.69V0.0186232Z"></path>
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M59.9208 7.02362C60.8939 5.80607 62.3 4.77941 64.7351 4.77941C67.3867 4.77941 68.9255 6.13199 68.9255 9.02571C68.9108 9.84541 68.8117 10.6614 68.6299 11.4608L66.9002 19.6438H62.435L64.0647 12.0684C64.21 11.4746 64.2881 10.8662 64.2974 10.2549C64.2974 8.90233 63.7015 8.2272 62.4583 8.2272C60.7007 8.2272 59.4016 9.47036 58.8592 12.0684L57.2296 19.6438H52.7784L52.7809 19.6322H49.9942C47.1284 19.6322 45.855 19.1991 45.855 17.2227C45.8722 16.6582 45.9447 16.0968 46.0715 15.5465L47.3472 9.57979C46.8392 9.48395 46.323 9.43872 45.8061 9.44476C43.9134 9.44476 42.5864 10.0919 42.1534 12.2593L40.5843 19.6438H36.1215L39.2038 5.07741H43.5339L42.9729 7.74997C43.9949 6.18089 45.6431 4.90979 47.8617 4.90979H48.3413L49.1561 1.09417H53.6189L52.7552 5.07275H55.8703L56.9432 0.0162887H61.4084L59.9208 7.02362ZM55.199 8.23652H52.0778L50.6972 14.7503C50.648 14.991 50.6207 15.2357 50.6158 15.4813C50.6158 16.2496 51.0767 16.4125 52.2663 16.4125H53.4641L55.199 8.23652Z"
        ></path>
      </svg>
    </div>
  </div>

  <!-- footer bottom -->
  <div class="w-full mt-12 pb-5 text-muted-foreground text-body-md flex justify-between">
    <span>© Fourthwall</span>

    {FOOTER_BOTTOM_LINKS.map((item) => (
      <a
        href={item.url}
        aria-label={item.name}
        class={cn(
          "link-underline text-inherit [transition:color_0.2s] after:-bottom-0.5 hover:text-white hover:decoration-white",
        )}
      >
        {item.name}
      </a>
    ))}

    <button
      data-scroll-to="top"
      aria-label="Back to top"
      class="cursor-pointer text-inherit bg-surface-dark inline-flex items-center p-0 no-underline transition-[color_.2s] hover:text-white"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        class="shrink-0 size-6"
      >
        <path
          d="M12 19V5M5 12l7-7 7 7"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </button>
  </div>
</section>

<script>
  import gsap from "gsap";

  const section = document.querySelector<HTMLElement>(
    "[data-wordmark-section]",
  );

  if (section) {
    // reveal on scroll (once)
    const wrap = section.querySelector<HTMLElement>(".footer-wordmark-wrap");

    if (wrap) {
      const revealObserver = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) {
              entry.target.classList.remove("is-visible");
              continue;
            }
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        },
        { threshold: 0.1 },
      );
      revealObserver.observe(wrap);
    }

    // scroll to top
    const scrollToTopBtn = section.querySelector<HTMLElement>(
      "[data-scroll-to='top']",
    );
    if (scrollToTopBtn) {
      scrollToTopBtn.addEventListener("click", () => {
        document.body.scrollIntoView({ behavior: "smooth" });
      });
    }

    // 3d rotation on mouse move
    gsap.set(".wordmark-section", { perspective: 1200 });

    const outerRX = gsap.quickTo(".logo", "rotationX", {
      ease: "power3",
    });
    const outerRY = gsap.quickTo(".logo", "rotationY", {
      ease: "power3",
    });
    // const innerX = gsap.quickTo(".logo", "x", { ease: "power3" });
    // const innerY = gsap.quickTo(".logo", "y", { ease: "power3" });

    section?.addEventListener("pointermove", (e: PointerEvent) => {
      outerRX(gsap.utils.interpolate(15, -15, e.y / window.innerHeight));
      outerRY(gsap.utils.interpolate(-15, 15, e.x / window.innerWidth));
    });

    section?.addEventListener("pointerleave", (e) => {
      outerRX(0);
      outerRY(0);
      //   innerX(0);
      //   innerY(0);
    });
  }
</script>
