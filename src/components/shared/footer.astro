---
import { FOOTER_LINKS } from "@/data";
import { cn } from "@/utils";
---

<footer class="z-1 pt-3.5 pb-8 2md:py-14 px-surface-x shadow-[0_4px_0_var(--text-foreground)] bg-surface-dark flex flex-col sticky bottom-0">
  <div class="grid grid-cols-6 min-[768px]:max-[992px]:grid-cols-3 gap-8 w-full origin-[50%] reveal">
    {FOOTER_LINKS.map((link) => (
      <div class="footer-group">
        <h3 class="mt-0 mb-4.5 text-white font-[inherit] [font-size:inherit] leading-[inherit] [font-weight:inherit]">
          <button class="footer-toggle" type="button" aria-expanded="true">
            {link.title}
            <span aria-hidden="true">+</span>
          </button>
        </h3>
        <ul class="my-0 pl-0 list-none">
          {link.links.map((item) => (
            <li class="mb-2.5">
              <a
                href={item.url}
                aria-label={item.name}
                class={cn(
                  "link-underline text-muted-foreground [transition:color_0.2s] after:-bottom-0.5 hover:text-white hover:decoration-white",
                )}
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div>
      <h3 class="mt-0 mb-4.5 text-white font-[inherit] [font-size:inherit] leading-[inherit] [font-weight:inherit]">
        Get the app
      </h3>
      <div class="flex flex-col gap-4 items-start w-full">
        <a
          href="https://apps.apple.com/us/app/fourthwall-for-creators/id1479668990"
          target="_blank"
          rel="nofollow"
          aria-label="Download on the App Store"
          class="rounded-lg bg-[#ffffff1a] hover:bg-[#ffffff29] w-full max-w-37 no-underline block [transition:background-color_0.2s]"
        >
          <img
            src="https://fourthwall.com/webflow-cdn/63ff7c6ecc83f97ec5fe9155/6a90730d84dd5e7e02ae04cb_badge-app-store.svg"
            alt="Download on the App Store"
            width="148"
            height="44"
            class="w-auto max-w-full h-10 object-contain"
          />
        </a>
        <a
          href="https://play.google.com/store/apps/details?id=com.fourthwall.android"
          target="_blank"
          rel="nofollow"
          aria-label="Get it on Google Play"
          class="rounded-lg bg-[#ffffff1a] hover:bg-[#ffffff29] w-full max-w-37 no-underline block [transition:background-color_0.2s]"
        >
          <img
            src="https://fourthwall.com/webflow-cdn/63ff7c6ecc83f97ec5fe9155/6a90730d9cab5f62a7a481ef_badge-google-play.svg"
            alt="Get it on Google Play"
            width="148"
            height="44"
            class="w-auto max-w-full h-10 object-contain"
          />
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  import { initReveal } from "@/lib";
  initReveal();
</script>

<script>
  const mobileFooter = matchMedia("(max-width: 767px)");
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>(".footer-group"),
  );
  function setGroupOpen(group: HTMLElement, open: boolean) {
    const button = group.querySelector<HTMLButtonElement>(".footer-toggle")!;
    button.setAttribute("aria-expanded", String(open));
    button.querySelector("span")!.textContent = open ? "−" : "+";
    group.querySelector<HTMLElement>("ul")!.inert = !open;
    group.dataset.open = String(open);
  }
  function resetFooter() {
    groups.forEach((group) => {
      const button = group.querySelector<HTMLButtonElement>(".footer-toggle")!;
      button.disabled = !mobileFooter.matches;
      setGroupOpen(group, !mobileFooter.matches);
    });
  }
  groups.forEach((group, index) => {
    const button = group.querySelector<HTMLButtonElement>(".footer-toggle")!;
    const links = group.querySelector<HTMLElement>("ul")!;
    links.id = `footer-links-${index}`;
    button.setAttribute("aria-controls", links.id);
    button.addEventListener("click", () => {
      if (!mobileFooter.matches) return;
      const open = button.getAttribute("aria-expanded") !== "true";
      groups.forEach((other) => {
        if (other.parentElement === group.parentElement) {
          setGroupOpen(other, other === group && open);
        }
      });
    });
  });
  mobileFooter.addEventListener("change", resetFooter);
  resetFooter();
</script>
<style>
  .footer-toggle {
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
  }
  .footer-toggle span {
    display: none;
  }
  @media (max-width: 767px) {
    footer > div {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .footer-group {
      border-bottom: 1px solid #ffffff14;
    }
    .footer-group h3 {
      margin: 0;
    }
    .footer-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding-block: 22px;
    }
    .footer-toggle span {
      display: block;
      color: var(--muted-foreground);
    }
    .footer-group ul {
      max-height: 0;
      overflow: hidden;
      margin: 0;
      visibility: hidden;
      transition:
        max-height 0.5s var(--ease-rise-in),
        visibility 0s 0.5s;
    }
    .footer-group[data-open="true"] ul {
      max-height: 350px;
      padding-bottom: 16px;
      visibility: visible;
      transition-delay: 0s;
    }
    footer > div > div:last-child {
      padding-top: 28px;
    }
    footer > div > div:last-child h3 {
      display: none;
    }
    footer > div > div:last-child > div {
      flex-direction: row;
      gap: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-group ul,
    .footer-toggle span {
      transition: none;
    }
  }
</style>
