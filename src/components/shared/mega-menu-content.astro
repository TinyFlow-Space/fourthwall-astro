---
import {
  FEATURE_GROUPS,
  EXPAND_LINKS,
  ELI_CARD,
  LEARN_CARDS,
  APP_LINKS,
} from "@/data/mega-menu";
interface Props {
  kind: string;
}
const { kind } = Astro.props;
---

{kind === "Features" ? (
  <div class="features-content">
    <div class="feature-columns">
      {FEATURE_GROUPS.map((group) => (
        <div class="feature-group">
          <h3>{group.title}</h3>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="expand-links">
        <h3>Expand Fourthwall</h3>
        {EXPAND_LINKS.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>
    <aside class="news-card">
      <h3>What’s new</h3>
      <a href={ELI_CARD.href}>
        <img
          src={ELI_CARD.image}
          alt="Ask Eli"
          width="400"
          height="260"
          loading="lazy"
        />
        <p>{ELI_CARD.description}</p>
      </a>
    </aside>
  </div>
) : (
  <div class="learn-content">
    <div class="learn-cards">
      {LEARN_CARDS.map((card) => (
        <a class="learn-card" href={card.href}>
          <img
            src={card.image}
            alt=""
            width="450"
            height="300"
            loading="lazy"
          />
          <span>{card.label}</span>
          <p>{card.description}</p>
        </a>
      ))}
    </div>
    <div class="learn-bottom">
      <a href="https://discord.com/invite/t5Vm6Q2425">
        Join our Discord community
      </a>
      <div class="app-links">
        <span>Get the app</span>
        {APP_LINKS.map((app) => (
          <a href={app.href}>
            <img
              src={app.image}
              alt={app.label}
              width="130"
              height="38"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </div>
  </div>
)}
<style>
  h3 {
    color: #858585;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 11px;
    font-weight: 400;
    margin: 0 0 20px;
  }
  a {
    color: white;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  a:focus-visible {
    outline: 2px solid white;
    outline-offset: 5px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  p {
    color: #858585;
    line-height: 1.45;
    margin: 12px 0 0;
  }
  .features-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 0.22fr);
    gap: 40px;
  }
  .feature-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 44px 30px;
  }
  .expand-links {
    grid-column: 1/-1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
    border-top: 1px solid #242424;
    padding-top: 32px;
  }
  .expand-links h3 {
    margin: 0;
  }
  .news-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1.54;
    object-fit: cover;
  }
  .learn-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }
  .learn-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1.5;
    object-fit: cover;
    margin-bottom: 18px;
  }
  .learn-card p {
    max-width: 29ch;
    margin-top: 10px;
  }
  .learn-bottom {
    border-top: 1px solid #242424;
    margin-top: 40px;
    padding-top: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .app-links {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #858585;
  }
  .app-links a {
    background: #242424;
    border-radius: 8px;
  }
  .app-links img {
    width: 130px;
    height: 38px;
  }
  @media (max-width: 991px) {
    h3 {
      font-size: 12px;
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .features-content,
    .feature-columns {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    ul {
      gap: 0;
    }
    li a,
    .expand-links > a {
      display: block;
      padding: 10px 0;
      font-size: 16px;
      line-height: 1.2;
    }
    .expand-links {
      display: flex;
      flex-direction: column;
      gap: 0;
      border: 0;
      padding: 0;
    }
    .expand-links h3 {
      margin-bottom: 12px;
    }
    .news-card {
      max-width: 335px;
    }
    .news-card p,
    .learn-card p {
      font-size: 14px;
    }
    .learn-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 16px;
    }
    .learn-card {
      font-size: 16px;
    }
    .learn-bottom {
      align-items: start;
      flex-direction: column;
      font-size: 16px;
    }
    .app-links {
      flex-wrap: wrap;
    }
    .app-links > span {
      width: 100%;
    }
  }
</style>
