---
interface Props {
  title: string;
  id: string;
}

const { title, id } = Astro.props;
---

<div
  class="accordion-item bg-paper-soft [transition:background_0.2s] hover:bg-[#efeff0]"

  data-open="false"
>
  <button
    class="accordion-trigger flex w-full cursor-pointer items-center justify-between gap-x-4 border-none py-3.5 px-4 md:px-6 md:py-5 text-left text-body-md leading-normal font-[450] text-foreground"
    type="button"
    aria-expanded="false"
    aria-controls={`faq-panel-${id}`}
    id={`faq-trigger-${id}`}
  >
    {title}
    <svg
      class="accordion-icon size-5 shrink-0 text-secondary-foreground"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path d="M5 12h14" />
      <path class="accordion-icon-vertical" d="M12 5v14" />
    </svg>
  </button>

  <div
    class="accordion-panel px-6 grid grid-cols-1 grid-rows-[0fr] transition-[grid-template-rows] duration-320"
    id={`faq-panel-${id}`}
    aria-labelledby={`faq-trigger-${id}`}
    inert
  >
    <div class="max-w-[60ch] text-foreground text-body-md leading-relaxed overflow-hidden">
      <slot />
    </div>
  </div>
</div>

<style>
  .accordion-item[data-open="true"] .accordion-panel {
    grid-template-rows: 1fr;
    padding-bottom: 20px;
  }

  .accordion-icon path {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2.5;
  }

  .accordion-icon-vertical {
    transform-origin: center;
    transition: transform 220ms ease;
  }

  .accordion-item[data-open="true"] .accordion-icon-vertical {
    transform: scaleY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-panel,
    .accordion-icon-vertical {
      transition: none;
    }
  }
</style>
