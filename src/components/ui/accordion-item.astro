---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  class="accordion-item bg-paper-soft [transition:background_0.2s]"
  data-accordion-item
  data-open="false"
>
  <button
    class="accordion-trigger flex w-full cursor-pointer items-center justify-between gap-x-4 border-none px-6 py-5 text-left text-body-md leading-normal font-medium text-foreground"
    type="button"
    data-accordion-trigger
  >
    {title}
    <svg
      class="accordion-icon size-5 shrink-0 text-secondary-foreground"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path d="M5 12h14" />
      <path class="accordion-icon-vertical" d="M12 5v14" />
    </svg>
  </button>

  <div
    class="accordion-panel px-6 grid grid-cols-1 grid-rows-[0fr] transition-[grid-template-rows] duration-320"
    data-accordion-panel
  >
    <div class="max-w-[60ch] text-foreground text-body-md leading-relaxed overflow-hidden">
      <slot />
    </div>
  </div>
</div>

<style>
  .accordion-item[data-open="true"] .accordion-panel {
    grid-template-rows: 1fr;
    padding-bottom: 20px;
  }

  .accordion-icon path {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2.5;
  }

  .accordion-icon-vertical {
    transform-origin: center;
    transition: transform 220ms ease;
  }

  .accordion-item[data-open="true"] .accordion-icon-vertical {
    transform: scaleY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-panel,
    .accordion-icon-vertical {
      transition: none;
    }
  }
</style>
