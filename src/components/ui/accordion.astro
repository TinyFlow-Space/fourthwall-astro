---
import { cn } from "@/utils";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={cn("accordion flex flex-col gap-y-1", className)}>
  <slot />
</div>

<script>
  document.querySelectorAll<HTMLElement>(".accordion").forEach((root) => {
    root.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest<HTMLButtonElement>(".accordion-trigger");
      if (!trigger || !root.contains(trigger)) return;

      const item = trigger.closest<HTMLElement>(".accordion-item");
      if (!item || item.closest(".accordion") !== root) return;

      const shouldOpen = trigger.getAttribute("aria-expanded") !== "true";

      root
        .querySelectorAll<HTMLButtonElement>(".accordion-trigger")
        .forEach((itemTrigger) => {
          const accordionItem =
            itemTrigger.closest<HTMLElement>(".accordion-item");
          if (!accordionItem || accordionItem.closest(".accordion") !== root) {
            return;
          }

          itemTrigger.setAttribute("aria-expanded", "false");
          accordionItem.setAttribute("data-open", "false");
          accordionItem.querySelector<HTMLElement>(".accordion-panel")!.inert =
            true;
        });

      if (!shouldOpen) return;

      trigger.setAttribute("aria-expanded", "true");
      item.setAttribute("data-open", "true");
      item.querySelector<HTMLElement>(".accordion-panel")!.inert = false;
    });
  });
</script>
