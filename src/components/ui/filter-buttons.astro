---
/** Emits selection-change with detail.value. */
interface Props {
  items: readonly (string | { label: string; value: string; href?: string })[];
  selected?: string;
  label?: string;
  id?: string;
  className?: string;
}

const {
  items,
  selected,
  label = "Select an option",
  id,
  className,
} = Astro.props;
const options = items.map((item) =>
  typeof item === "string"
    ? { label: item, value: item, href: undefined }
    : item,
);
const selectedValue =
  options.find((item) => item.value === selected)?.value ?? options[0]?.value;
---

<div
  data-filter-buttons
  id={id}
  role="group"
  aria-label={label}
  class:list={[
    "filter-nav scrollbar-none flex flex-nowrap gap-2 relative overflow-auto -mx-[clamp(1rem,1.5038vw+.6476rem,2rem)] px-[clamp(1rem,1.5038vw+.6476rem,2rem)] md:mx-0 md:px-0",
    className,
  ]}
>
  <div
    aria-hidden="true"
    class="hover-pill pointer-events-none z-0 bg-[#0a0a0a0f] absolute top-0 left-0 bottom-0 rounded-lg transition-[transform_0.28s_cubic-bezier(0.2,0.7,0.2,1),width_0.28s_cubic-bezier(0.2,0.7,0.2,1)] motion-reduce:transition-none"
  ></div>
  {options.map((item) => {
    const Tag = item.href ? "a" : "button";
    return (
      <Tag
        type={item.href ? undefined : "button"}
        href={item.href}
        data-value={item.value}
        value={item.href ? undefined : item.value}
        role={item.href ? "button" : undefined}
        class:list={[
          "filter-item z-1 text-secondary-foreground hover:text-foreground! text-body-md leading-none font-medium cursor-pointer shrink-0 mb-0 relative py-3.5 px-4.5 2md:py-4.5 2md:px-5 rounded-lg whitespace-nowrap transition-colors duration-200 inline-block border-none",
          { "text-foreground!": item.value === selectedValue },
        ]}
        aria-pressed={item.value === selectedValue}
      >
        {item.label}
      </Tag>
    );
  })}
</div>

<script>
  const cleanups = new Map<HTMLElement, () => void>();

  function initializeFilters() {
    document
      .querySelectorAll<HTMLElement>("[data-filter-buttons]")
      .forEach((nav) => {
        if (cleanups.has(nav)) return;
        const controller = new AbortController();
        const { signal } = controller;
        const pill = nav.querySelector<HTMLElement>(".hover-pill");
        const buttons = Array.from(
          nav.querySelectorAll<HTMLButtonElement | HTMLAnchorElement>(
            ".filter-item",
          ),
        );
        const initialSelectedButton = buttons.find(
          (button) => button.getAttribute("aria-pressed") === "true",
        );
        let hoveredButton: HTMLButtonElement | HTMLAnchorElement | null = null;

        if (!pill || !initialSelectedButton) return;
        let selectedButton = initialSelectedButton;
        selectedButton.classList.add("text-foreground!");

        let positionFrame = 0;
        const schedulePillPosition = () => {
          if (positionFrame) return;

          positionFrame = window.requestAnimationFrame(() => {
            positionFrame = 0;
            const button = hoveredButton ?? selectedButton;
            const { offsetWidth, offsetLeft } = button;

            pill.style.width = `${offsetWidth}px`;
            pill.style.transform = `translateX(${offsetLeft}px)`;
          });
        };

        const positionCurrentButton = () => {
          schedulePillPosition();
        };

        buttons.forEach((button) => {
          button.addEventListener(
            "keydown",
            (event) => {
              if (
                button instanceof HTMLAnchorElement &&
                event instanceof KeyboardEvent &&
                event.key === " "
              ) {
                event.preventDefault();
                button.click();
              }
            },
            { signal },
          );
          button.addEventListener(
            "pointerenter",
            () => {
              hoveredButton = button;
              schedulePillPosition();
            },
            { signal },
          );

          button.addEventListener(
            "focus",
            () => {
              hoveredButton = button;
              schedulePillPosition();
            },
            { signal },
          );

          button.addEventListener(
            "blur",
            () => {
              hoveredButton = null;
              schedulePillPosition();
            },
            { signal },
          );

          button.addEventListener(
            "click",
            (event) => {
              if (
                event instanceof MouseEvent &&
                (event.metaKey ||
                  event.ctrlKey ||
                  event.shiftKey ||
                  event.altKey ||
                  event.button !== 0)
              )
                return;
              selectedButton = button;
              buttons.forEach((item) => {
                const isSelected = item === selectedButton;
                item.setAttribute("aria-pressed", String(isSelected));
                item.classList.toggle("text-foreground!", isSelected);
              });
              nav.dispatchEvent(
                new CustomEvent("selection-change", {
                  detail: { value: button.dataset.value },
                  bubbles: true,
                }),
              );
              schedulePillPosition();
            },
            { signal },
          );
        });

        // Restore selection from URL/history without triggering a new request.
        nav.addEventListener(
          "selection-set",
          (event) => {
            const value = (event as CustomEvent<{ value: string }>).detail
              .value;
            const button =
              buttons.find((item) => item.dataset.value === value) ??
              buttons[0];
            if (!button) return;
            selectedButton = button;
            hoveredButton = null;
            buttons.forEach((item) => {
              const selected = item === button;
              item.setAttribute("aria-pressed", String(selected));
              item.classList.toggle("text-foreground!", selected);
            });
            schedulePillPosition();
          },
          { signal },
        );

        nav.addEventListener(
          "pointerleave",
          () => {
            hoveredButton = null;
            schedulePillPosition();
          },
          { signal },
        );

        positionCurrentButton();
        // Keep a directly linked tab visible in the existing scrollable mobile row.
        nav.scrollLeft = Math.max(
          0,
          selectedButton.offsetLeft -
            (nav.clientWidth - selectedButton.offsetWidth) / 2,
        );
        const resizeObserver = new ResizeObserver(positionCurrentButton);
        resizeObserver.observe(nav);
        buttons.forEach((button) => resizeObserver.observe(button));
        cleanups.set(nav, () => {
          controller.abort();
          resizeObserver.disconnect();
          window.cancelAnimationFrame(positionFrame);
        });
      });
  }

  initializeFilters();
  document.addEventListener("astro:page-load", initializeFilters);
  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((cleanup) => cleanup());
    cleanups.clear();
  });
</script>
