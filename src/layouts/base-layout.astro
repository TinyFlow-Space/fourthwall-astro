---
import { Font } from "astro:assets";
import "@/styles/global.css";
import Header from "@/components/shared/header.astro";
import Footer from "@/components/shared/footer.astro";
import WordMark from "@/components/sections/wordmark.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = "/og.png" } = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, siteUrl);
const ld = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Fourthwall",
  url: canonical.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <Font cssVariable="--font-inter" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(ld)}
    />
  </head>

  <body class="bg-background text-foreground min-h-svh m-0 font-body text-body-md overflow-x-hidden leading-relaxed antialiased">
    <Header />
    <main class="z-2 bg-surface-dark block relative">
      <slot />
    </main>
    <Footer />
    <WordMark />
  </body>
</html>
