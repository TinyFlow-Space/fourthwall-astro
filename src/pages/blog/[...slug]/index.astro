---
import Newsletter from "@/components/blog/newsletter.astro";
import BlogDetailsArticle from "@/components/blog/sections/blog-details-article.astro";
import Blogs from "@/components/blog/sections/blogs.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { getPost, getRelated } from "@/lib/sanity/client";
import { imageUrl, postHref } from "@/lib/sanity/presentation";
import type { Post, PostSummary } from "@/lib/sanity/types";
export const prerender = false;
const { slug } = Astro.params;
let post: Post | null = null;
let related: PostSummary[] = [];
let failed = false;
if (slug && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
  try {
    post = await getPost(slug);
  } catch {
    failed = true;
  }
}
if (post) {
  try {
    related = await getRelated(post);
  } catch {
    /* The article remains usable if recommendations fail. */
  }
}
Astro.response.status = failed ? 503 : post ? 200 : 404;
Astro.response.headers.set("Cache-Control", "no-store");
const title =
  post?.title ?? (failed ? "Article unavailable" : "Article not found");
const structured = post
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.title,
      description: post.excerpt,
      datePublished: post.publishedAt,
      dateModified: post._updatedAt,
      image: imageUrl(post.mainImage, 1200),
      author: post.author
        ? { "@type": "Person", name: post.author.name }
        : undefined,
      mainEntityOfPage: new URL(postHref(post.slug), Astro.site ?? Astro.url)
        .href,
    }
  : null;
---

<BaseLayout
  title={`${title} | Fourthwall`}
  description={post?.excerpt ?? title}
  image={imageUrl(post?.mainImage, 1200)}
  noindex={!post}
  article={!!post}
  className="z-3 bg-background"
>
  {structured && (
    <script
      slot="head"
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, "\\u003c")}
    />
  )}
  {post ? (
    <>
      <BlogDetailsArticle post={post} />
      <Blogs
        posts={related}
        showTitle={true}
        showFilter={false}
        searchQuery=""
      />
      <Newsletter />
    </>
  ) : (
    <section class="container-lg px-6 pt-40 pb-24 text-center">
      <h1 class="text-4xl mb-6">{title}</h1>
      <p>
        {failed
          ? "We couldn’t load this article. Please try again shortly."
          : "This article may have moved or is no longer available."}
      </p>
      {failed && (
        <a href={Astro.url.pathname} class="underline mr-6">
          Try again
        </a>
      )}
      <a href="/blog" class="underline">
        Browse all posts
      </a>
    </section>
  )}
</BaseLayout>
