---
import Newsletter from "@/components/blog/newsletter.astro";
import BlogDetailsArticle from "@/components/blog/sections/blog-details-article.astro";
import Blogs from "@/components/blog/sections/blogs.astro";
import BaseLayout from "@/layouts/base-layout.astro";

export const prerender = false;

const { slug } = Astro.params;
---

<BaseLayout title={slug!} description="Hello" className="z-3 bg-background">
  <BlogDetailsArticle />

  <Blogs showFilter={false} showTitle={true} />
  <Newsletter />
</BaseLayout>
