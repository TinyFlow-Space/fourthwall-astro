---
import BaseLayout from "@/layouts/base-layout.astro";
import Hero from "@/components/sections/hero.astro";
import TrustedBrands from "@/components/sections/trusted-brands.astro";
import Cta from "@/components/sections/cta.astro";
import Accordion from "@/components/sections/accordion.astro";
import Creators from "@/components/sections/creators.astro";
import FeaturedProducts from "@/components/sections/featured-products.astro";
import Testimonials from "@/components/sections/testimonials.astro";
import Products from "@/components/sections/products.astro";
import Operations from "@/components/sections/operations.astro";
import MadeWith from "@/components/sections/made-with.astro";
---

<BaseLayout
  title="Fourthwall | One platform for custom products and branded shops"
  description="Launch your online shop with Fourthwall. Create and sell custom products, offer memberships, and build a fully branded website with ease."
>
  <Hero />
  <FeaturedProducts />
  <TrustedBrands />
  <Operations />
  <Testimonials />
  <Products />
  <Creators />
  <MadeWith />
  <Accordion />
  <Cta />
</BaseLayout>

<script>
  import { initReveal, initScatterReveal } from "@/lib";
  initReveal();
  initScatterReveal();
</script>
