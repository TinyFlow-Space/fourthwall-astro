---
import BaseLayout from "@/layouts/base-layout.astro";
import Hero from "@/components/home/sections/hero.astro";
import TrustedBrands from "@/components/home/sections/trusted-brands.astro";
import Accordion from "@/components/home/sections/faq.astro";
import Creators from "@/components/home/sections/creators.astro";
import FeaturedProducts from "@/components/home/sections/featured-products.astro";
import Testimonials from "@/components/home/sections/testimonials.astro";
import Products from "@/components/home/sections/products.astro";
import Operations from "@/components/home/sections/operations.astro";
import MadeWith from "@/components/home/sections/made-with.astro";
import ProductDesign from "@/components/home/sections/product-design.astro";
import BrandShowcase from "@/components/home/sections/brand-showcase.astro";
---

<BaseLayout
  title="Fourthwall | One platform for custom products and branded shops"
  description="Launch your online shop with Fourthwall. Create and sell custom products, offer memberships, and build a fully branded website with ease."
>
  <Hero />
  <FeaturedProducts />
  <TrustedBrands />
  <BrandShowcase />
  <ProductDesign />
  <Operations />
  <Testimonials />
  <Products />
  <Creators />
  <MadeWith />
  <Accordion />
</BaseLayout>

<script>
  import { initReveal } from "@/scripts/animations/reveal";
import { initScatterReveal } from "@/scripts/animations/scatter-reveal";
  initReveal();
  initScatterReveal();
</script>
